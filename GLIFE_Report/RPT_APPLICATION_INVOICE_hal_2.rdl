                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Klaim</Value>
                              <Style>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>9pt</FontSize>
                              </Style>
