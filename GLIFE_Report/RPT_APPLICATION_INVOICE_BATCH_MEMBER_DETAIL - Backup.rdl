  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>select 
a.CODE,
b.DESCR,
AMOUNT		= isnull(a.AMOUNT,0) * (case when b.MODE = 0 then -1 else 1 end)
from APPLICATION_PREMIUM_COMPONENT a
inner join PARAM_PREMIUM_COMPONENT b on a.CODE = b.CODE
where
a.REGNO = @REGNO
and isnull(a.AMOUNT,0) &gt; 0

union all

select
b.CODE collate database_default,
b.DESCR  collate database_default,
AMOUNT		= (-1) * (e.AMOUNT * a.VAL / 100)
from APPLICATION_LOADING a
inner join PR_LOADING b on LOADING_CODE = b.CODE
inner join (select REGNO, AMOUNT = SUM(SUMINS * isnull(RATE,0))/1000 from APPLICATION_BENEFIT group by REGNO) e on a.REGNO = e.REGNO
where
a.REGNO = @REGNO
and isnull(a.NETT, 0) = 1
and isnull(a.VAL, 0) &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>0</Timeout>
      </Query>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="REGNO">
      <DataType>String</DataType>
      <Prompt>REGNO</Prompt>
    </ReportParameter>
  </ReportParameters>
</Report>