        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_SAVING_SUMMARY
@START_DATE,
@END_DATE,
@TRANS_TYPE,
@POLICY_NO,
@COMPANY_NAME</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
