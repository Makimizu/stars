        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Mohon dibayarkan kepada PT. Asuransi Takaful Keluarga sejumlah Rp. </Value>
                <Style>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Sum(Fields!AMOUNT.Value, "PREMIUM_COMPONENT")</Value>
                <Style>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <Format>#,0;(#,0)</Format>
                </Style>
              </TextRun>
              <TextRun>
                <Value> untuk pembayaran kontribusi Asuransi Jiwa Pembiayaan dengan data sebagai berikut :</Value>
                <Style>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
