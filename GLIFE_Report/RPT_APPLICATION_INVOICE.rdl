    <DataSet Name="PREMIUM_COMPONENT">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_INVOICE_PREMIUM_COMPONENT @REGNO, ''</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select top 1
FULLNAME_DESCR	= 'Nama Pasangan',
FULLNAME_AGE	= 'Usia Pasangan',
FULLNAME_DOB	= 'Tanggal Lahir',
COLON			= ':',
FULLNAME		= a.FULLNAME,
START_AGE		= dbo.UFN_AGE_CALC(a.DOB, b.START_DATE, convert(int, isnull(c.VAL,'2'))),
DOB				= a.DOB
from APPLICATION_JOIN_ACCOUNT a
inner join APPLICATION_MAIN_INFO b on a.REGNO = b.REGNO
inner join V_APPLICATION_TC_ITEMS c on a.REGNO = c.REGNO and c.TC_ITEM = '13'
where
a.REGNO = @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="FULLNAME_DESCR">
          <DataField>FULLNAME_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FULLNAME_AGE">
          <DataField>FULLNAME_AGE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FULLNAME_DOB">
          <DataField>FULLNAME_DOB</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COLON">
          <DataField>COLON</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FULLNAME">
          <DataField>FULLNAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_AGE">
          <DataField>START_AGE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DOB">
          <DataField>DOB</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
