          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>2.      Dalam menghitung usia Peserta, berlaku ketentuan sebagai berikut :</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
