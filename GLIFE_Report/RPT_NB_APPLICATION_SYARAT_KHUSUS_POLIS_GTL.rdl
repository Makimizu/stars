          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>          a.     Usia Peserta ditetapkan dalam satuan tahunan dan dihitung pada saat diterima menjadi Peserta Takaful.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Lato</FontFamily>
