      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_APPLICATION_CLAIM_MASTER
@TRACK_DATE_FROM,
@TRACK_DATE_TO,
@LAST_TRACK</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@TRACK_DATE_FROM">
            <Value>=Parameters!TRACK_DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TRACK_DATE_TO">
            <Value>=Parameters!TRACK_DATE_TO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@LAST_TRACK">
            <Value>=Parameters!LAST_TRACK.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>0</Timeout>
      </Query>
