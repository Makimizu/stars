    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select CODE, DESCR from V_LINK_UB_PRODUCT_GROUP where CODE in ('SP','CL','GTL','GTLR') order by 2 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
