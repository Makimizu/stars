  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FULLNAME">
            <Value>=Parameters!FULLNAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STATUS">
            <Value>=Parameters!STATUS.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@COMPANY_NAME">
            <Value>=Parameters!COMPANY_NAME.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_GTLR
@POLICY_NO, 
@FULLNAME,  
@STATUS,
@COMPANY_NAME</CommandText>
      </Query>
