                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox28">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>PT. Asuransi Takaful Keluarga dibebaskan dari kewajiban membayar manfaat meninggal dunia jika Peserta mengalami musibah sebagai akibat dari salah satu hal di bawah ini :</Value>
                              <Style>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value />
                              <Style>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Bunuh diri; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Perbuatan melawan hukum atau dihukum mati oleh pengadilan yang berwenang; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Terlibat dalam perkelahian kecuali jika terbukti sebagai pihak yang mempertahankan diri; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Akibat perbuatan yang disengaja, yang direncanakan dengan persetujuan Peserta atau Yang Ditunjuk; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Wabah penyakit (epidemi), yang ditetapkan oleh PT. Asuransi Takaful Keluarga; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Cedera atau penyakit yang disebabkan secara sengaja oleh perbuatan sendiri untuk melukai/menyakiti diri sendiri, penyalahgunaan alkohol atau obat terlarang; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Penyakit hubungan seksual (sexually transmitted diseases) seperti Gonorrhea/ Syphilis atau lainnya serta segala akibatnya; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Terinfeksi virus Human Immunodeficiency Virus (HIV), Acquired Immune Deficiency Syndrome (AIDS), AIDS Related Complex (ARC) atau infeksi oportunistik lain, Neoplasma (tumor) ganas yang ditemukan sehubungan dengan infeksi HIV, AIDS atau ARC;</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Untuk tujuan pengecualian disini, istilah Acquired Immune Deficiency Syndrome mempunya arti yang ditetapkan oleh Organisasi Kesehatan Dunia (WHO), pada saat konfirmasi pertama. Diagnosa atas atau pembedahan untuk kondisi tersebut, sesuai yang ditentukan; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Bulleted</ListStyle>
                          <ListLevel>2</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Infeksi oportunistik termasuk tetapi tidak terbatas pada Pneumocystis Carniipneumonia, organisme dari virus enteritis yang kronis infeksi jamur yang menyebar; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Bulleted</ListStyle>
                          <ListLevel>2</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Neoplasma (tumor) ganas termasuk tidak terbatas pada Kaposi’s Sarcoma, Limfoma Saraf Pusat keganasan lainnya yang tidak diketahui atau yang kemudian diketahui sebagai penyebab kematian sehubungan dengan Acquired Immune Deficiency Syndrome tersebut; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Bulleted</ListStyle>
                          <ListLevel>2</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Abortus, kecuali dengan alasan kesehatan; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Melahirkan atau kehamilan pada tahun pertama kepesertaan; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Perang atau segala tindakan peperangan baik yang dinyatakan atau tidak; partisipasi aktif dalam demonstrasi/ huru-hara/ kerusuhan/ pengacauan atau kekacauan/ perbuatan teror/ pemberontakan atau keributan sipil/ kudeta/ kegaduhan sipil atau keadaan yang dapat disamakan dengan itu; atau</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Pengecualian lain yang dinyatakan dalam Syarat-syarat Khusus Polis atau Endorsemen Polis.</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Lato</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Numbered</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox28</rd:DefaultName>
