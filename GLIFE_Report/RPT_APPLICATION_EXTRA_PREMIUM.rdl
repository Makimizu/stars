        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>sehingga jumlah premi yang harus dibayar sebesar Rp. </Value>
                <Style>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!NETT_PREMIUM.Value, "RPT_APPLICATION_EXTRA_PREMIUM")</Value>
