                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>) untuk Calon Peserta asuransi pembiayaan dengan data sebagai berikut :</Value>
                <Style>
