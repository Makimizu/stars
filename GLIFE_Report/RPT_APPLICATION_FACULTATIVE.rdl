                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>
Bersama ini kami mengajukan permohonan fakultatif (</Value>
                <Style>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!UW_CODE.Value, "RPT_APPLICATION_FACULTATIVE")</Value>
