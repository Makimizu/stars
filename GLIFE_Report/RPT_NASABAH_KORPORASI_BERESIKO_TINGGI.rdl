  <DataSources>
    <DataSource Name="GLIFE">
      <DataSourceReference>GLIFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b00a3160-8769-4be2-9838-79d315736f34</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
A.COMPANY_NAME
, A.FULLNAME
, A.POLICY_NO
, A.TC_DESCR
, A.START_DATE
, A.END_DATE
, DATED = CONCAT(FORMAT(A.START_DATE, 'yyyy-MM-dd'), ' - ', FORMAT(A.END_DATE, 'yyyy-MM-dd'))
, A.SUMINS
, FLAG = GLIFE.dbo.UFN_IS_COMPANY_BLACKLISTED(a.COMPANY_NAME)
FROM V_APPLICATION_MASTER A
WHERE A.REGNO=@REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FULLNAME">
          <DataField>FULLNAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TC_DESCR">
          <DataField>TC_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DATED">
