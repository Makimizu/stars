        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_DATE">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
FIRST_DOM = convert(date, convert(varchar(2), month(GETDATE())) + '/1/' + convert(varchar(4), year(GETDATE()))),
LAST_DOM = dateadd(day, -1, dateadd(month, 1, convert(date, convert(varchar(2), month(GETDATE())) + '/1/' + convert(varchar(4), year(GETDATE())))))</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRST_DOM">
          <DataField>FIRST_DOM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LAST_DOM">
          <DataField>LAST_DOM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TRACKS">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select SEQ = null, DESCR = '' union all
select SEQ, DESCR from PARAM_TRACK where TIPE_CODE = 'CLM' AND SEQ &lt;&gt; 6</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
