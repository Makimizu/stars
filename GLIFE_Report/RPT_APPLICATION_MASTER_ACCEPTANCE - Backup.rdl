      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_APPLICATION_MASTER_ACCEPTANCE
@ACCEPTANCE_DATE_FROM,
@ACCEPTANCE_DATE_TO</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@ACCEPTANCE_DATE_FROM">
            <Value>=Parameters!ACCEPTANCE_DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ACCEPTANCE_DATE_TO">
            <Value>=Parameters!ACCEPTANCE_DATE_TO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>0</Timeout>
      </Query>
