  <DataSources>
    <DataSource Name="GLIFE">
      <DataSourceReference>GLIFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>86e2a5ca-f75f-482b-abbe-90ba4fe7ef09</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="PREMIUM_ADJUSTMENT">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
a.CODE,
b.DESCR,
AMOUNT		= isnull(a.AMOUNT,0) * (case when b.MODE = 0 then -1 else 1 end)
from APPLICATION_PREMIUM_COMPONENT a
inner join PARAM_PREMIUM_COMPONENT b on a.CODE = b.CODE
where
a.REGNO = @REGNO
and isnull(a.AMOUNT,0) &gt; 0

union all

select
b.CODE collate database_default,
b.DESCR  collate database_default,
AMOUNT		= (-1) * (e.AMOUNT * a.VAL / 100)
from APPLICATION_LOADING a
inner join PR_LOADING b on LOADING_CODE = b.CODE
inner join (select REGNO, AMOUNT = SUM(SUMINS * isnull(RATE,0))/1000 from APPLICATION_BENEFIT group by REGNO) e on a.REGNO = e.REGNO
where
a.REGNO = @REGNO
and isnull(a.NETT, 0) = 1
and isnull(a.VAL, 0) &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="REGNO">
      <DataType>String</DataType>
      <Prompt>REGNO</Prompt>
    </ReportParameter>
  </ReportParameters>
  <Language>en-US</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>48fa0383-22f7-4ef4-8623-ed937e6b9b60</rd:ReportID>
