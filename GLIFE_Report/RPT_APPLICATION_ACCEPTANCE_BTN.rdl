    <DataSet Name="TRACK">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select SEQ, DESCR from PARAM_TRACK where TIPE_CODE = 'UW' and SEQ = 4 union all
select SEQ, DESCR from PARAM_TRACK where TIPE_CODE = 'UW' and SEQ not in (4, 98)</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>SELECT
START_DATE	= convert(date, DATEADD(yy, DATEDIFF(yy, 0, GETDATE()), 0)),
END_DATE	= convert(date, DATEADD(yy, DATEDIFF(yy, 0, GETDATE()) + 1, -1))</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="POLICY">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
POLICY_NO		= a.POLICY_NO,
COMPANY_NAME	= a.POLICY_NO + ' - ' + b.COMPANY_NAME
from		POLICY a
inner join	V_LINK_CB_COMPANY b on a.COMPANY_CODE = b.COMPANY_CODE and (b.COMPANY_NAME like '%BTN%' or b.COMPANY_NAME like '%BANK TABUNGAN NEGARA%')
inner join	(	select
				POLICY_ID,
				MEMBER		= count(REGNO)
				from		APPLICATION_MASTER
				group by
				POLICY_ID
				) c on a.ID = c.POLICY_ID
order by 1</CommandText>
      </Query>
      <Fields>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
