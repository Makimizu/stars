      <Textbox Name="Textbox61">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Demikian pemberitahuan ini kami sampaikan, untuk informasi dan penjelasan lebih lanjut dapat menghubungi kami di nomor :021-79190005 atau E-mail : claim-atk@takaful.com.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Tahoma</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>General</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>
Atas perhatian dan kerjasamanya serta kepercayaan yang telah diberikan kami ucapkan terima kasih.</Value>
