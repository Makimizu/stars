          </QueryParameter>
          <QueryParameter Name="@TRX_DATE_TO">
            <Value>=Parameters!TRX_DATE_TO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_POS_APPLICATION_SAVING_MEMBER
@TRX_DATE_FROM,
@TRX_DATE_TO</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
