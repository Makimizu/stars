    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
START_DATE = convert(date, convert(varchar(2), MONTH(GETDATE())) + '/1/' + convert(varchar(4), YEAR(GETDATE()))),
END_DATE = EOMONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
