                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>Underline</TextDecoration>
                  <Color>Blue</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>. Demikian atas perhatiannya kami ucapkan terima kasih.</Value>
