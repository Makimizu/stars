    <DataSet Name="JENIS_PRODUCT">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select case when b.PRODUCT_GROUP = 'CL' THEN 'Pembiayaan' else 'Kumpulan' end JENIS_PRODUCT from APPLICATION_MASTER a join POLICY b
on a.POLICY_ID = b.ID
where a.REGNO = @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="JENIS_PRODUCT">
          <DataField>JENIS_PRODUCT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
