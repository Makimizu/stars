    <DataSet Name="TTD_DIRUT">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>SELECT 
USER_SIGNATURE			= RTRIM(LTRIM(isnull(H.FRONT_NAME,'') + ' ' + isnull(H.LAST_NAME,''))),
USER_SIGNATURE_BINARY	= H.SIGNATURE,
USER_SIGNATURE_TITLE	= H.POSITION_TITLE
 FROM V_LINK_SC_M_USERS H WHERE H.CODE = 'angki'</CommandText>
