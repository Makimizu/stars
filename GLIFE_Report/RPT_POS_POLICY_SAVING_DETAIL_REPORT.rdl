    <DataSet Name="HEADER">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT POLICY_NO, COMPANY_NAME, TC_DESCR FROM V_POLICY where POLICY_NO = @POLICY_NO</CommandText>
      </Query>
      <Fields>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TC_DESCR">
          <DataField>TC_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="POLICY">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
POLICY_NO,
COMPANY_NAME = POLICY_NO + ' - ' + LTRIM(UPPER(b.COMPANY_NAME))
from POLICY a
inner join V_LINK_CB_COMPANY b on a.COMPANY_CODE = b.COMPANY_CODE
where
PRODUCT_GROUP = 'SP'
order by
LTRIM(b.COMPANY_NAME)</CommandText>
      </Query>
      <Fields>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD_DEFAULT">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
END_DATE	= convert(date, GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
