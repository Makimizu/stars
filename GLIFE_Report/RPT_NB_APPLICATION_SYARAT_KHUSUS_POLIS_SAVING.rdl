          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>1.      Saldo Dana Tabungan Peserta dihitung pada setiap Tanggal Perhitungan dimana nilainya adalah sebesar total Kontribusi Dana Peserta ditambah jumlah hasil investasi yang terbentuk dari Kontribusi Dana Peserta tersebut, pada Tanggal Perhitungan yang bersangkutan.</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <LeftIndent>0.29583in</LeftIndent>
            <HangingIndent>-21.3pt</HangingIndent>
            <Style>
              <TextAlign>Left</TextAlign>
              <LineHeight>13pt</LineHeight>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>         Total Kontribusi Dana Peserta yang dimaksud pada pasal ini adalah Kontribusi Peserta setelah dikurangi Kontribusi Tabarru’ dan Ujrah</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
