        </Style>
      </Textbox>
      <Textbox Name="Textbox39">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Demikian pemberitahuan ini kami sampaikan, untuk informasi dan penjelasan lebih lanjut dapat menghubungi layanan Peserta Takaful Keluarga 021-79190005 atau 0807.100.3456 e-mail cs_atk@takaful.com.</Value>
                <Style>
                  <FontFamily>Tahoma</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
