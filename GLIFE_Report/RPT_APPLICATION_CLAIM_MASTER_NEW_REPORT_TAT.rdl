    <DataSet Name="TRACKS">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select SEQ = null, DESCR = '' union all
select SEQ, DESCR from PARAM_TRACK where TIPE_CODE = 'CLM'</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
