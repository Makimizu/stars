          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>2.      </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>Ujrah </Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>sebagaimana dimaksud pada ayat 1 Pasal ini berasal dari biaya-biaya yang dibebankan kepada Pemegang Polis/ Peserta, yaitu :</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Lato</FontFamily>
                  <FontSize>9pt</FontSize>
                  <FontWeight>Normal</FontWeight>
