  <DataSets>
    <DataSet Name="FIRST_DOM">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
FIRST_DOM = convert(date, convert(varchar(4),year(GETDATE())) + '/' + convert(varchar(4),month(GETDATE())) + '/1'),
TODAY = convert(date, GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRST_DOM">
          <DataField>FIRST_DOM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="THIS_COMPANY">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
NAME = UPPER(NAME), 
SMALL_LOGO
from V_LINK_SC_SC_COMPANY where CODE = '1'</CommandText>
      </Query>
      <Fields>
        <Field Name="NAME">
          <DataField>NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SMALL_LOGO">
          <DataField>SMALL_LOGO</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
