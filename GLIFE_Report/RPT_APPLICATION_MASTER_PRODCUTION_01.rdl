        <Field Name="LAST_TRACK_DESCR">
          <DataField>LAST_TRACK_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UWCODE">
          <DataField>UWCODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="REGDATE">
          <DataField>REGDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="REMARK">
          <DataField>REMARK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TRACKS">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
SEQ = null,
DESCR = ''
union all
select
SEQ = 0,
DESCR = 'PENDING'
union all
select
SEQ, DESCR
from PARAM_TRACK where TIPE_CODE = 'UW'
</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FIRST_DOM">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
FIRST_DOM = convert(date, convert(varchar(4),year(GETDATE())) + '/' + convert(varchar(4),month(GETDATE())) + '/1'),
TODAY = convert(date, GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRST_DOM">
          <DataField>FIRST_DOM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="THIS_COMPANY">
      <Query>
        <DataSourceName>GLIFE</DataSourceName>
        <CommandText>select
NAME = UPPER(NAME), 
SMALL_LOGO
from V_LINK_SC_SC_COMPANY where CODE = '1'</CommandText>
      </Query>
      <Fields>
        <Field Name="NAME">
          <DataField>NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SMALL_LOGO">
          <DataField>SMALL_LOGO</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
