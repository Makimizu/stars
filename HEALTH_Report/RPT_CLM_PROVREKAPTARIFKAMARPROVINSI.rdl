      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>RPT_CLM_PROVREKAPTARIFKAMARPROVINSI</CommandText>
        <QueryParameters>
          <QueryParameter Name="@PROPINSI">
            <Value>=Parameters!PROPINSI.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STAT">
            <Value>=Parameters!STAT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CREATEDATE">
            <Value>=Parameters!CREATEDATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="PROPINSI">
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT '0000000000' CODE, 'ALL' DESCR
UNION 
SELECT CODE, DESCR FROM dbo.PR_PROPINSI WHERE CODE NOT IN ('00')</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="STAT">
      <Fields>
        <Field Name="STAT">
          <DataField>STAT</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT * FROM(SELECT 2 STAT, 'ALL' DESCR
union 
SELECT CODE STAT, DESCR FROM PR_STATUS_PROVIDER) X ORDER BY STAT DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="TAHUN">
      <Fields>
        <Field Name="YearNum">
          <DataField>YearNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT YEAR(GETDATE()) as YearNum
UNION
SELECT YEAR(GETDATE()) - 1 as YearNum
UNION
SELECT YEAR(GETDATE()) - 2 as YearNum
UNION
SELECT YEAR(GETDATE()) - 3 as YearNum
UNION
SELECT YEAR(GETDATE()) - 4 as YearNum
UNION
SELECT YEAR(GETDATE()) - 5 as YearNum
ORDER BY YearNum DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
