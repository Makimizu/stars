First(Fields!CompanyPIC.Value, "RPT_CLM_SURAT_PEMBAYARAN_PER_CABANG"),
First(Fields!CompanyPICTitle.Value, "RPT_CLM_SURAT_PEMBAYARAN_PER_CABANG") &amp; " " &amp; First(Fields!CompanyPIC.Value, "RPT_CLM_SURAT_PEMBAYARAN_PER_CABANG"))</Value>
