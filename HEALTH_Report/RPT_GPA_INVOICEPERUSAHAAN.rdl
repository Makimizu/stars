      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>RPT_GPA_INVOICEPERUSAHAANPERBULAN</CommandText>
        <QueryParameters>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TAHUN">
            <Value>=Parameters!TAHUN.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BULAN">
            <Value>=Parameters!BULAN.Value</Value>
          </QueryParameter>
        </QueryParameters>
