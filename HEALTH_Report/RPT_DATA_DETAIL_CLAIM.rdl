  <DataSources>
    <DataSource Name="CUSTOMER_PORTAL">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=192.168.100.92;Initial Catalog=CUSTOMER_PORTAL</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>66bff482-55c5-47ac-9f25-c0d105261f7b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="STANDARD">
      <Query>
        <DataSourceName>CUSTOMER_PORTAL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CLAIM_NO">
            <Value>=Parameters!CLAIM_NO.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select CLAIM_NO,
                                    a.NAMA,  
                                    a.LAST_TRACK_DESCR,  
                                    a.PROVIDER,  
                                    THEDATE = convert(varchar(20), a.TGL_RAWAT_DARI, 106) + ' - ' + convert(varchar(20), a.TGL_RAWAT_SAMPAI, 106),  
                                    a.BENEFIT_DESCR, 
                                    a.PR_DESCR 
                                    from V_LINK_HO_CLM_CLAIM_MASTER a 
                                    where 
                                    CLAIM_NO =@CLAIM_NO</CommandText>
      </Query>
      <Fields>
        <Field Name="CLAIM_NO">
          <DataField>CLAIM_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAMA">
          <DataField>NAMA</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LAST_TRACK_DESCR">
          <DataField>LAST_TRACK_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PROVIDER">
          <DataField>PROVIDER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="THEDATE">
          <DataField>THEDATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BENEFIT_DESCR">
          <DataField>BENEFIT_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PR_DESCR">
          <DataField>PR_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RPT_DATA_DETAIL_CLAIM">
      <Query>
        <DataSourceName>CUSTOMER_PORTAL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CLAIM_NO">
            <Value>=Parameters!CLAIM_NO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>RPT_DATA_DETAIL_CLAIM</CommandText>
      </Query>
      <Fields>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INCURRED">
          <DataField>INCURRED</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="REJECTED">
          <DataField>REJECTED</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PAID">
          <DataField>PAID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DIAGNOSA">
      <Query>
        <DataSourceName>CUSTOMER_PORTAL</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CLAIM_NO">
            <Value>=Parameters!CLAIM_NO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select a.ID, b.DESCR
                                   from V_LINK_HO_CLAIM_ICD a
                                   inner join V_LINK_HO_PR_ICD b on a.ICD_CODE = b.CODE
                                   where
                                   a.CLAIM_NO = @CLAIM_NO</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
