              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox77">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Sebelumnya kami sampaikan terima kasih untuk bantuan dan kerjasamanya yang baik dalam hal pemberian pelayanan kesehatan bagi peserta asuransi kesehatan </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>PT. </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!COMPANY_SECURITY.Value</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>.</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value />
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Left</TextAlign>
                          </Style>
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Sehubungan telah berakhirnya perjanjian kerjasama </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!NO_PKS.Value</Value>
                              <Style>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value xml:space="preserve"> </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!TGL_PKS.Value</Value>
                              <Style>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <Format>dd/MM/yyyy</Format>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>, maka dalam kesempatan ini kami bermaksud untuk mengajukan perpanjangan perjanjian kerjasama pemberian pelayanan kesehatan antara </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
