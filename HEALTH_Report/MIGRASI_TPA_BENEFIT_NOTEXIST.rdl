  <DataSources>
    <DataSource Name="ASKES">
      <DataSourceReference>ASKES</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>79754195-b805-4e6b-8f24-9c68944ef177</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select
g.COMPANY_NAME,
e.TPA,
f.POLICY_NO,
PACKAGE_DESCR = c.DESCR,
d.BENEFIT_ID,
b.PLAN_CODE,
BENEFIT_DETAIL_ID = a.MORBIDITY_ID
from POLICY_PERIOD_PACKAGE_BENEFIT_DETAIL a
inner join POLICY_PERIOD_PACKAGE_PLAN b on a.POLICY_PERIOD_PACKAGE_PLAN_ID=b.ID
inner join POLICY_PERIOD_PACKAGE c on b.POLICY_PERIOD_PACKAGE=c.ID
inner join POLICY_PERIOD_BENEFIT d on b.POLICY_PERIOD_BENEFIT_ID=d.ID
inner join POLICY_PERIOD e on c.POLICY_PERIOD_ID=e.ID
inner join POLICY f on e.POLICY_ID=f.ID
inner join COMPANY g on f.COMPANY_CODE=g.COMPANY_CODE
where
a.UP_P = 888888888</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TPA">
          <DataField>TPA</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PACKAGE_DESCR">
          <DataField>PACKAGE_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BENEFIT_ID">
          <DataField>BENEFIT_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PLAN_CODE">
          <DataField>PLAN_CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BENEFIT_DETAIL_ID">
          <DataField>BENEFIT_DETAIL_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
