                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox86">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Berdasarkan formulir Permohonan Peserta Kesehatan dan berdasarkan keterangan-keterangan dari Peserta. Manfaat Takaful Polis ini diberikan berdasarkan Syarat-Syarat Umum Polis, Syarat-Syarat Khusus Polis, dan Ikhtisar Polis termasuk tetapi tidak terbatas pada Endorsemen Polis serta Lampiran Polis, yang semuanya dilampirkan pada Polis dan disetujui Peserta serta menjadi bagian yang saling melengkapi dan tidak dapat dipisahkan dengan Polis ini.</Value>
                              <Style>
                                <FontFamily>Tahoma</FontFamily>
                                <FontSize>11pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Left</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox86</rd:DefaultName>
