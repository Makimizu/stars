    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select PRODUCT = '' 

union all

select 
	PRODUCT = f.DESCR 
FROM dbo.POLICY a
INNER JOIN dbo.POLICY_PERIOD b ON a.ID = b.POLICY_ID
INNER JOIN PARAM_ACT_PRODUCT F on b.PRODUCT_CODE = f.CODE
group by f.DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="PRODUCT">
          <DataField>PRODUCT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
