    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select 
FIRSTDATE = convert(date,dateadd(day, -(DAY(GETDATE()))+1, GETDATE())),
TODAY = convert(date,GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRSTDATE">
          <DataField>FIRSTDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select CODE = '', DESCR = '' union all
select CODE = 'P', DESCR = 'PROVIDER' union all
select CODE = 'R', DESCR = 'REIMBURSEMENT' 
</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
