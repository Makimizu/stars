    <DataSet Name="TRACK">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select
SEQ,
DESCR
from PARAM_TRACK 
where
TIPE_CODE = 'CLMMASTER'
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PR">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select  CODE = '', DESCR = '' union all
select  CODE = 'P', DESCR = 'PROVIDER' union all
select  CODE = 'R', DESCR = 'REIMBURSE' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
