                          <TextRuns>
                            <TextRun>
                              <Value>Jika pihak </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!NAMAPROVIDER.Value</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value> membutuhkan komunikasi dengan pihak PT. BNI Life Insurance, maka dapat menghubungi nomor telepon khusus (</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>021) 27895100/ (021) 53667627</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>, atau dapat menghubungi telepon emergency di nomor (021) 53667617 / (021) 53667656 serta email melalui </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>provider.helpdesk@bni-life.co.id</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>Underline</TextDecoration>
                                <Color>Blue</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
