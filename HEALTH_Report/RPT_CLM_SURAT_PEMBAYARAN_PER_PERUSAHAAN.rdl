  <Code>Public Function IndonesianFormatNumber(ByVal value As String)
        Dim formattedData As String
        Dim numericLength As Integer
        numericLength = Len(value)
        formattedData = ""
        While numericLength &gt; 0
            If numericLength &gt; 3 Then
                formattedData = "." + value.Substring(numericLength - 3, 3) + formattedData
                value = value.Substring(0, numericLength - 3)
                numericLength = Len(value)
            Else
                formattedData = value + formattedData
                numericLength = 0
            End If
        End While
        formattedData = formattedData + ",-"
        Return formattedData
    End Function

 Shared offset as Integer
 Shared currentgroup as Object
Public Function GetGroupPageNumber(group as Object, pagenumber as Integer) as Object
  If Not (group = currentgroup) and Not(group Is Nothing)
    offset = pagenumber - 1
    currentgroup = group
  End If
  Return pagenumber - offset
End Function</Code>
