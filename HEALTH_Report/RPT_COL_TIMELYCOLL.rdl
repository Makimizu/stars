    <DataSet Name="dsBulan">
      <Fields>
        <Field Name="Bulan">
          <DataField>Bulan</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Nama_Bulan">
          <DataField>Nama_Bulan</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>

SELECT * FROM (
SELECT 1 Bulan, 'Januari' Nama_Bulan
UNION
SELECT 2 Bulan, 'Februari' Nama_Bulan
UNION
SELECT 3 Bulan, 'Maret' Nama_Bulan
UNION
SELECT 4 Bulan, 'April' Nama_Bulan
UNION
SELECT 5 Bulan, 'Mei' Nama_Bulan
UNION
SELECT 6 Bulan, 'Juni' Nama_Bulan
UNION
SELECT 7 Bulan, 'Juli' Nama_Bulan
UNION
SELECT 8 Bulan, 'Agustus' Nama_Bulan
UNION
SELECT 9 Bulan, 'September' Nama_Bulan
UNION
SELECT 10 Bulan, 'Oktober' Nama_Bulan
UNION
SELECT 11 Bulan, 'November' Nama_Bulan
UNION
SELECT 12 Bulan, 'Desember' Nama_Bulan
) A ORDER BY BULAN</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
