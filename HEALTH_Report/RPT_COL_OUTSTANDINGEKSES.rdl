      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>RPT_COL_OUTSTANDINGEKSESPREMI</CommandText>
        <QueryParameters>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@POLICY_PERIOD_ID">
            <Value>=Parameters!POLICY_PERIOD_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PREMI_EKSES">
            <Value>=Parameters!PREMI_EKSES.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@THN_AKHIRPOLICY">
            <Value>=Parameters!THN_AKHIRPOLICY.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="dsPolicyPeriod">
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT NULL AS ID, '' AS DESCR
UNION
SELECT  ID = A.ID, CONVERT(VARCHAR,A.START_DATE,105) + ' s/d ' + CONVERT(VARCHAR,A.END_DATE,105) AS DESCR
FROM    dbo.POLICY_PERIOD A
               JOIN dbo.POLICY B ON A.POLICY_ID = B.ID
WHERE POLICY_NO=@POLICY_NO    </CommandText>
        <QueryParameters>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="dsPremiEkses">
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 'PRM' AS CODE, 'PREMI' AS DESCR
UNION
SELECT 'EKS' AS CODE, 'EKSES' AS DESCR</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
