      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select '' CODE, '' DESCR
union all
SELECT CODE, DESCR FROM PR_TIPE_KORESPONDEN WHERE CODE IN ('EXS','PRM')</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
