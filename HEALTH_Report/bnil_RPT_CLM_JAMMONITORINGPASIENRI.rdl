                  <CellContents>
                    <Textbox Name="Textbox221">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Jika pihak [Nama Provider] membutuhkan komunikasi dengan pihak PT. BNI Life Insurance, maka dapat menghubungi nomor telepon khusus (</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>021) 2789 5100/ (021) 53667627</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>, atau dapat menghubungi telepon emergency di nomor </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>0812-1070922</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value> dan faksimili di nomor </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>(021) 53667617</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>/ </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>(021) 53667656</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value> serta email melalui provider.helpdesk@bni-life.co.id</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value />
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>NOTE : Jawaban Informasi monitoring perkembangan medis kami tunggu paling lambat 1 X 24 Jam</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
