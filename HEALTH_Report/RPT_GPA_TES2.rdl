  <DataSources>
    <DataSource Name="ASKES">
      <DataSourceReference>ASKES</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5449de6c-de8b-4327-9962-0633236b5368</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>declare

@AR_DATE_FROM datetime,
@AR_DATE_TO datetime,
@TIPE varchar(10)

set @AR_DATE_FROM = '1 sep 2017'
set @AR_DATE_TO  = '30 sep 2017'
set @TIPE = '1'



select 
a.TIPE,
a.POLICY_PERIOD_ID,
a.POLICY_NO,
a.REGNO,
a.AMOUNT,
a.AR_DATE,
a.AP_DATE,
EFF_DATE		= b.TGL_MASUK,
a.BATCH_ID,
a.NAMA,
a.USIA_REG,
a.DOB,
a.SEX,
j.DESCR,
a.COMPANY_NAME,
PREMIUM_PACKAGE	 = c.DESCR,
BENEFIT_ID		 = e.BENEFIT_ID,
BENEFIT_ORDER_NO = h.ORDER_NO,
PREMIUM			 = 50 * CEILING((g.PREMIUM * convert(float,(datediff(day,b.TGL_MASUK, a.END_DATE) + 1))/(datediff(day,a.START_DATE, a.END_DATE) + 1))/50) + (case when e.BENEFIT_ID='IP' then isnull(i.BASIC_CHG,0) else 0 end),
--,b.TGL_MASUK,a.START_DATE, a.END_DATE,
INSURANCE_PERIOD = dbo.UFN_SET_INDO_DATE(a.START_DATE) + ' - ' + dbo.UFN_SET_INDO_DATE(a.END_DATE),
AGENT_NAME = RTRIM(k.FRONT_NAME + ' ' + isnull(k.LAST_NAME,'')),
SUB_CODE_DESCR = l.DESCR
from V_PESERTA_MASTER_MOVEMENT_EXT a
left join
(
	select  
	aa.REGNO,
	TGL_MASUK = isnull(cc.TGL_MASUK, bb.START_DATE),
	aa.PACKAGE,
	bb.ID,
	bb.AGENT_CODE,
	bb.START_DATE,
	bb.END_DATE
	from PESERTA_NBRN aa
	inner join POLICY_PERIOD bb on aa.BATCH_ID=bb.ID and convert(date,getdate()) &lt;= END_DATE
	left join PESERTA_MASUK_TEMP cc on aa.REGNO=cc.REGNO and (convert(date,cc.TGL_MASUK) between convert(date,bb.START_DATE) and convert(date, bb.END_DATE))
	
)b on a.REGNO = b.REGNO
inner join POLICY_PERIOD_PACKAGE c on b.PACKAGE=c.ID
inner join POLICY_PERIOD_PACKAGE_PLAN d on c.ID=d.POLICY_PERIOD_PACKAGE
inner join POLICY_PERIOD_BENEFIT e on d.POLICY_PERIOD_BENEFIT_ID=e.ID
inner join PARAM_MAPPING_GROUP_MEMBER f on a.SEX=f.SEX and a.FAMILY_GROUP=f.FAMILY_CODE
left join POLICY_PERIOD_PACKAGE_PREMIUM g on g.POLICY_PERIOD_PACKAGE_PLAN_ID=d.ID and f.GROUP_MEMBER=g.GROUP_ID and (a.USIA_REG between g.MIN_AGE and g.MAX_AGE)
inner join PARAM_ACT_BENEFIT h on e.BENEFIT_ID=h.ID
inner join POLICY_PERIOD_TPA i on a.POLICY_PERIOD_ID=i.POLICY_PERIOD_ID 
inner join PR_FAMILY_GROUP j on a.FAMILY_GROUP = j.CODE
inner join V_LINK_MARKETING_M_AGENTS k on b.AGENT_CODE=k.CODE collate database_default
inner join V_LINK_MARKETING_PARAM_SUB_CHANNEL_DISTRIBUTION l on k.SUB_CODE=l.SUB_CODE
where
convert(date,a.AR_DATE) &gt;= convert(date,isnull(@AR_DATE_FROM,'1 jan 1980'))
and convert(date,a.AR_DATE) &lt;= convert(date,isnull(@AR_DATE_TO,GETDATE()))


and @TIPE = '1' and a.TIPE in ('N') 


order by a.TIPE</CommandText>
      </Query>
