                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Tambahan :</Value>
                                  <Style>
                                    <FontStyle>Italic</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
