                              <TextRuns>
                                <TextRun>
                                  <Value>Kami, selaku dokter perusahaan yang diberikan kewenangan oleh PT. BNI Life Insurance, meminta bantuan kepada teman sejawat untuk memberikan informasi dalam bentuk jawaban pertanyaan yang kami lampirkan pada lembaran setelah surat ini.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value />
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                                <LineHeight>12pt</LineHeight>
                              </Style>
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Jawaban atas pertanyaan yang ada pada lembaran tersebut sangat kami perlukan untuk membantu proses penjaminan layanan kesehatan dan analisa klaim peserta asuransi kesehatan PT. BNI Life Insurance.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                                <LineHeight>12pt</LineHeight>
                              </Style>
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value />
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Jika pihak </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!NAMAPROVIDER.Value</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> membutuhkan komunikasi dengan pihak PT. BNI Life Insurance, maka dapat menghubungi nomor telepon khusus (</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>021) 2789 5100/ (021) 53667627</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>, atau dapat menghubungi telepon emergency di nomor </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>0812-1070922</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> dan faksimili di nomor </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>(021) 53667617</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>/ </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>(021) 53667656</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> serta email melalui provider.helpdesk@bni-life.co.id</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
