    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="TANGGALSURAT">
          <DataField>TANGGALSURAT</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NOSURAT">
          <DataField>NOSURAT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TUJUAN">
          <DataField>TUJUAN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ALAMAT">
          <DataField>ALAMAT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NOENDORSEMENT">
          <DataField>NOENDORSEMENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="USERBY_NAME">
          <DataField>USERBY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT  USERDATE TANGGALSURAT, 
		DOCNO NOSURAT, 
		COMPANY_NAME TUJUAN, 
		ALAMAT,
		BATCH_ID NOENDORSEMENT,
		USERBY_NAME
FROM    V_GPA_ENDORSEMENT_BATCH_PRINTCARD
WHERE	CONVERT(DATETIME,CONVERT(VARCHAR,USERDATE,103),103)  BETWEEN @TANGGALSURATSTART AND @TANGGALSURATEND</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TANGGALSURATSTART">
            <Value>=Parameters!TANGGALSURATSTART.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TANGGALSURATEND">
            <Value>=Parameters!TANGGALSURATEND.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
