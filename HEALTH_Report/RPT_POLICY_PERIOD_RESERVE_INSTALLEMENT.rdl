          </QueryParameter>
          <QueryParameter Name="@PERIOD_START_TO">
            <Value>=Parameters!PERIOD_START_TO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_POLICY_PERIOD_RESERVE_INSTALLEMENT
@POLICY_NO,
@COMPANY_NAME,
@PERIOD_START_FROM,
@PERIOD_START_TO</CommandText>
