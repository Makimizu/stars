    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select
FIRST_DATE = convert(date, dateadd(year, -1, GETDATE())),
TO_DATE = convert(date, GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRST_DATE">
          <DataField>FIRST_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
