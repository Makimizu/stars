    </DataSet>
    <DataSet Name="DataSet2">
      <Fields>
        <Field Name="TAHUN">
          <DataField>tahun</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
WITH n(n) AS
(
    SELECT 0
    UNION ALL
    SELECT n+1 FROM n WHERE n &lt;= 10
)
SELECT convert(char(4),year(DATEADD( YY, -n, DATEADD(YEAR, 1, GetDate())))) AS TAHUN INTO #temp
FROM n ORDER BY TAHUN DESC

create table #TAHUN
(tahun VARCHAR(4))

insert into #TAHUN
SELECT ''

insert into #TAHUN
select * FROM #temp

select * from #TAHUN
drop table #TAHUN
drop table #temp</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
