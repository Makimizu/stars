        <CommandText>RPT_COL_ASKES_TAHUNAN</CommandText>
        <QueryParameters>
          <QueryParameter Name="@INV_PERIODE">
            <Value>=Parameters!INV_PERIODE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
