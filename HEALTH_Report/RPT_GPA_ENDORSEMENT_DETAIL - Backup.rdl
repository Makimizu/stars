      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_GPA_ENDORSEMENT_DETAIL
@TIPE,
@POLICY_NO,
@COMPANY_NAME,
@MEMBER_NAME,
@EFF_DATE_FROM,
@EFF_DATE_TO</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@TIPE">
            <Value>=Parameters!TIPE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@COMPANY_NAME">
            <Value>=Parameters!COMPANY_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MEMBER_NAME">
            <Value>=Parameters!MEMBER_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EFF_DATE_FROM">
            <Value>=Parameters!EFF_DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EFF_DATE_TO">
            <Value>=Parameters!EFF_DATE_TO.Value</Value>
          </QueryParameter>
