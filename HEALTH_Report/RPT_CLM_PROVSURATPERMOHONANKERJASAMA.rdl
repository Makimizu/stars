              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox1">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Dengan Hormat,</Value>
                              <Style>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Left</TextAlign>
                          </Style>
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value />
                              <Style>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Left</TextAlign>
                          </Style>
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Sebelumnya kami sampaikan terima kasih yang sebesar-besarnya atas kesempatan yang telah diberikan untuk mengajukan perjanjian kerjasama  dalam  hal pemberian pelayanan kesehatan bagi peserta asuransi kesehatan </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>PT. </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!COMPANY_SECURITY.Value</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>. Sekaligus juga, izinkanlah kami memperkenalkan </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>PT. </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
