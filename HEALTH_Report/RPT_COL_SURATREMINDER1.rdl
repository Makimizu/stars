                <Style>
                  <FontSize>8pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>(Please  ignore  this reminder</Value>
                <Style>
