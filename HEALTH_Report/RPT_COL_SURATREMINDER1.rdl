        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Pembayaran melalui transfer (Pemindahbukuan) wajib mencantumkan Nomor Invoice dengan benar pada bagian berita atau keterangan. </Value>
                <Style>
                  <FontSize>8pt</FontSize>
