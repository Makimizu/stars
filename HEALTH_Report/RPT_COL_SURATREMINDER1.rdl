      <Textbox Name="Textbox12">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Demi kenyamanan dalam memperoleh manfaat atas polis yang dimaksud, kami memberikan masa tenggang waktu sampai dengan tanggal </Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Label>TANGGALTEMPO</Label>
                <Value>=First(Fields!INVOICE_DUEDATE.Value, "DataSet1")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Format>d</Format>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>. Selama masa tenggang waktu tersebut, diharapkan </Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Label>NAMAPERUSAHAAN</Label>
                <Value>=First(Fields!COMPANY_NAME.Value, "DataSet1")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value> dapat melakukan pembayaran ke Nomor Rekening sebagai berikut :</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>(For your convenience and policy benefit, we would like to give you a grace period until </Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Label>TANGGALTEMPO_ENG</Label>
                <Value>=First(Fields!INVOICE_DUEDATE_ENG.Value, "DataSet1")</Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>. During this time  </Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Label>NAMAPERUSAHAAN</Label>
                <Value>=First(Fields!COMPANY_NAME.Value, "DataSet1")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value> is expected  to make a payment to the following account : )</Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Left</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
