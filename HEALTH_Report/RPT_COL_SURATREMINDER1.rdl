          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Sehubungan dengan kepemilikan polis </Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
