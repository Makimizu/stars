            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>(Payment by bank transfer shall state the invoice number correctly on the remarks or information field)</Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontSize>8pt</FontSize>
