              <TextRun>
                <Value>
 
Mohon pemberitahuan ini dapat diabaikan apabila </Value>
                <Style>
                  <FontSize>8pt</FontSize>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Label>NAMAPERUSAHAAN</Label>
                <Value>=First(Fields!COMPANY_NAME.Value, "DataSet1")</Value>
