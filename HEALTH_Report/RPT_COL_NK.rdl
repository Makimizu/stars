              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CONTACT">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Nota Kredit ini hanya sebagai informasi adanya pengembalian premi / pembatalan premi / pengurangan premi</Value>
                              <Style>
                                <FontFamily>arial</FontFamily>
                                <FontSize>9pt</FontSize>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Bulleted</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>(This Credit Note is only as information for the cancellation of the premium / premium reduction)</Value>
                              <Style>
                                <FontStyle>Italic</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListLevel>1</ListLevel>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Nilai pengembalian premi / pembatalan premi / pengurangan premi sebesar tersebut di atas akan mengurangi jumlah tagihan Saudara (bila ada), dan akan diperhitungkan kembali di dalam Statement Of Account yang akan diterbitkan setiap bulannya</Value>
                              <Style>
                                <FontFamily>arial</FontFamily>
                                <FontSize>9pt</FontSize>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListStyle>Bulleted</ListStyle>
                          <ListLevel>1</ListLevel>
                          <Style>
                            <TextAlign>Left</TextAlign>
                            <LineHeight>13pt</LineHeight>
                          </Style>
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>(Cancellation value premium / premium reductions will reduce the amount of your invoice (if any), and will be recalculated in the Statement Of Accounts that will be issued monthly)</Value>
                              <Style>
                                <FontStyle>Italic</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <ListLevel>1</ListLevel>
                          <Style>
                            <TextAlign>Left</TextAlign>
                            <LineHeight>13pt</LineHeight>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>CONTACT</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>White</Color>
                          <Style>Solid</Style>
                        </Border>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                    <ColSpan>8</ColSpan>
                  </CellContents>
                </TablixCell>
