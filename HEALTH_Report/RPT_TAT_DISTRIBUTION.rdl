          <ChartTitle Name="Title1">
            <Caption>="Average : " + format(Sum(Fields!DAYLEN.Value * Fields!FREQ.Value)/Sum(Fields!FREQ.Value),"#,0;(#,0)").ToString + " days     Highest Freq : " + Fields!HIGHESTFREQ_DAYLEN.Value.ToString + " days"</Caption>
