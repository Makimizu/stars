  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DATE_FROM">
            <Value>=Parameters!DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DATE_TO">
            <Value>=Parameters!DATE_TO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MODE">
            <Value>=Parameters!MODE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_TAT_DISTRIBUTION
@DATE_FROM,
@DATE_TO,
@MODE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DAYLEN">
          <DataField>DAYLEN</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FREQ">
          <DataField>FREQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TITLE">
          <DataField>TITLE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HIGHESTFREQ_DAYLEN">
          <DataField>HIGHESTFREQ_DAYLEN</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select 
FIRSTDATE = convert(date,convert(varchar(4),YEAR(GETDATE())) + '0101'),
TODAY = convert(date,GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRSTDATE">
          <DataField>FIRSTDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select CODE,DESCR from PR_SLA_TYPE</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="DATE_FROM">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSet2</DataSetName>
          <ValueField>FIRSTDATE</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>DATE FROM</Prompt>
    </ReportParameter>
    <ReportParameter Name="DATE_TO">
