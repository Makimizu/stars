    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select 
FIRSTDATE = dateadd(day, -(DAY(GETDATE()))+1, GETDATE()),
TODAY = GETDATE()</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRSTDATE">
          <DataField>FIRSTDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
