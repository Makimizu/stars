  <DataSources>
    <DataSource Name="ASKES">
      <DataSourceReference>ASKES</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>91097585-4f3e-49de-bd5c-973672836781</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PPID">
            <Value>=Parameters!PPID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select a.INVOICENO, CONVERT(varchar, a.INVOICE_DATE, 106) as INVOICE_DATE, a.INVOICE_TYPE_DESCR, a.AMOUNT as AMT, a.OUTSTANDING as OTS
from V_LINK_FINANCE_INVOICE_MASTER a, V_POLICY_PERIOD_INVOICE trx
where a.INVOICENO = isnull(trx.INVOICENO,'') 
and trx.POLICY_PERIOD_ID = @PPID
and a.OUTSTANDING &gt; 0
order by a.INVOICE_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="INVOICENO">
          <DataField>INVOICENO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INVOICE_DATE">
          <DataField>INVOICE_DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INVOICE_TYPE_DESCR">
          <DataField>INVOICE_TYPE_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMT">
          <DataField>AMT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OTS">
          <DataField>OTS</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
