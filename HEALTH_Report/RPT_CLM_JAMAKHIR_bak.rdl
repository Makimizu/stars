                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Sehubungan dengan informasi pelayanan jaminan kesehatan untuk peserta PT. </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>7pt</FontSize>
