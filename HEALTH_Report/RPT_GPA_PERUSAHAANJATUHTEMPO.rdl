<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="ASKES">
      <DataSourceReference>ASKES</DataSourceReference>
      <rd:DataSourceID>7f7cd959-7c64-4231-b84b-106ca4fa9fbb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Bulan">
      <Fields>
        <Field Name="MTH">
          <DataField>MTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MONTHNAME">
          <DataField>MONTHNAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>DECLARE @YEAR INT
SET @YEAR = DATEPART(YEAR,GETDATE()) ;

WITH  MTHS
        AS ( SELECT 1 AS MTH,
                    DATENAME(MONTH,CAST(@YEAR * 100 + 1 AS VARCHAR) + '01') AS [MONTHNAME]
             UNION ALL
             SELECT MTH + 1,
                    DATENAME(MONTH,CAST(@YEAR * 100 + ( MTH + 1 ) AS VARCHAR) + '01')
             FROM   MTHS
             WHERE  MTH &lt; 12
           )
  SELECT  MTH,
          CASE WHEN MTH = 1 THEN 'Januari'
               WHEN MTH = 2 THEN 'Februari'
               WHEN MTH = 3 THEN 'Maret'
               WHEN MTH = 4 THEN 'April'
               WHEN MTH = 5 THEN 'Mei'
               WHEN MTH = 6 THEN 'Juni'
               WHEN MTH = 7 THEN 'Juli'
               WHEN MTH = 8 THEN 'Agustus'
               WHEN MTH = 9 THEN 'September'
               WHEN MTH = 10 THEN 'Oktober'
               WHEN MTH = 11 THEN 'Nopember'
               WHEN MTH = 12 THEN 'Desember'
          END AS [MONTHNAME]
  FROM    MTHS</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="Tahun">
      <Fields>
        <Field Name="YearNum">
          <DataField>YearNum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT YEAR(GETDATE()) as YearNum
UNION
SELECT YEAR(GETDATE()) - 1 as YearNum
UNION
SELECT YEAR(GETDATE()) - 2 as YearNum
UNION
SELECT YEAR(GETDATE()) - 3 as YearNum
UNION
SELECT YEAR(GETDATE()) - 4 as YearNum
UNION
SELECT YEAR(GETDATE()) - 5 as YearNum
ORDER BY YearNum DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
