                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Apabila Bapak/Ibu membutuhkan penjelasan lebih lanjut silahkan hubungi Layanan Peserta kami di </Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
