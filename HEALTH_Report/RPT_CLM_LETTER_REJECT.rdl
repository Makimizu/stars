                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Berdasarkan analisa dan verifikasi lebih lanjut, kiranya pengajuan klaim tersebut tidak dapat kami realisasikan, karena :</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                                <TextDecoration>None</TextDecoration>
                                <Color>#000000</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Replace(Fields!REASON.Value,CHR(13),VbCrLf)</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontSize>9pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <TextDecoration>None</TextDecoration>
