    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select 
FIRSTDATE = convert(date,dateadd(day, -(DAY(GETDATE()))+1, GETDATE())),
TODAY = convert(date,GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRSTDATE">
          <DataField>FIRSTDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select CODE = '1', DESCR = 'MASIH DIJAMIN' union all
select CODE = '2', DESCR = 'JAMINAN SELESAI' union all
select CODE = '3', DESCR = 'TOLAK' union all
select CODE = '4', DESCR = 'ALL' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
