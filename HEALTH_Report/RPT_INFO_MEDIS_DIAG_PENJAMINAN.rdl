    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@NOSURAT">
            <Value>=Parameters!NOMOR_SURAT_JAMINAN.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SEQ">
            <Value>=Parameters!SEQ.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
	a.ICD_CODE,  
	c.DESCR  
	from CLAIM_SURAT_JAMINAN_MONITORING_ICD a  
	inner join CLAIM_SURAT_JAMINAN_MONITORING d on a.MONITORING_ID = d.ID 
	inner join CLAIM_SURAT_JAMINAN_MASTER b on d.SURAT_JAMINAN_ID = b.ID  
	inner join PR_ICD c on a.ICD_CODE=c.CODE  
	where  
	b.NOMOR_SURAT_JAMINAN = @NOSURAT
	and d.SEQ = @SEQ;</CommandText>
      </Query>
      <Fields>
        <Field Name="ICD_CODE">
          <DataField>ICD_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet4">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@NOSURAT">
            <Value>=Parameters!NOMOR_SURAT_JAMINAN.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@SEQ">
            <Value>=Parameters!SEQ.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select   
a.ID,  
a.KET_DOKTER_CODE,  
e.DESCR as KET_DOKTER_DESCR,
a.NAMA_DOKTER  
from CLAIM_SURAT_JAMINAN_MONITORING_DOKTER a  
inner join CLAIM_SURAT_JAMINAN_MONITORING c on a.MONITORING_ID = c.ID  
inner join CLAIM_SURAT_JAMINAN_MASTER d on c.SURAT_JAMINAN_ID = d.ID  
inner join PR_CLAIM_KETERANGAN_DOKTER e on a.KET_DOKTER_CODE = e.CODE
where  
d.NOMOR_SURAT_JAMINAN=@NOSURAT  
and c.SEQ=@SEQ</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="KET_DOKTER_CODE">
          <DataField>KET_DOKTER_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="KET_DOKTER_DESCR">
          <DataField>KET_DOKTER_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAMA_DOKTER">
          <DataField>NAMA_DOKTER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
