        <CommandType>StoredProcedure</CommandType>
        <CommandText>SP_CLM_SURAT_JAMINAN_MONITORING_INFO</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
