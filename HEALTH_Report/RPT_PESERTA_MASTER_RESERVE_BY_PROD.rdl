    <DataSet Name="RESERVE_DATE">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select 
RESERVE_DATE = CAST(convert(date,a.RESERVE_DATE) AS VARCHAR(50))
from PESERTA_MASTER_RESERVE a
group by
a.RESERVE_DATE
order by 
a.RESERVE_DATE desc</CommandText>
      </Query>
      <Fields>
        <Field Name="RESERVE_DATE">
          <DataField>RESERVE_DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
