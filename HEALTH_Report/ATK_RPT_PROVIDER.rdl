    <DataSet Name="PR_TITLE_PROVIDER">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT NULL AS CODE, 'ALL' AS DESCR
FROM            PR_TITLE_PROVIDER
UNION ALL
SELECT        CODE, UPPER(DESCR) AS DESCR
FROM            PR_TITLE_PROVIDER AS PR_TITLE_PROVIDER_1
ORDER BY DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PR_STATUS_PROVIDER">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select distinct null CODE,'ALL' DESCR from PR_STATUS_PROVIDER
union all
select CODE,DESCR from PR_STATUS_PROVIDER</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_TBL_KOTA_PROVIDER">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT NULL AS CODE, 'ALL' AS DESCR
FROM            PARAM_TBL_KOTA_PROVIDER
UNION ALL
SELECT        CODE, UPPER(DESCR) AS DESCR
FROM            PARAM_TBL_KOTA_PROVIDER AS PARAM_TBL_KOTA_PROVIDER_1
ORDER BY DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_ACT_TPA">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT '-' AS CODE, 'ALL' AS DESCR
FROM            PARAM_ACT_TPA
WHERE        (CODE NOT IN ('04', '05', '06', '07'))
UNION ALL
SELECT        CODE, DESCR
FROM            PARAM_ACT_TPA AS PARAM_ACT_TPA_1
WHERE        (CODE NOT IN ('04', '05', '06', '07'))</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
