        <Field Name="PLAN_CODE">
          <DataField>PLAN_CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BENEFIT_DETAIL_ID">
          <DataField>BENEFIT_DETAIL_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>select 
c.COMPANY_NAME,
a.* 
from TPA_CLAIM_BENEFIT_NOTEXIST a
inner join POLICY b on a.POLICY_NO=b.POLICY_NO
inner join COMPANY c on b.COMPANY_CODE=c.COMPANY_CODE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <Timeout>0</Timeout>
      </Query>
    </DataSet>
  </DataSets>
