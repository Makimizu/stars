      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>RPT_CLM_PROVREPORTDETAIL </CommandText>
        <QueryParameters>
          <QueryParameter Name="@KOTA">
            <Value>=Parameters!KOTA.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STAT">
            <Value>=Parameters!STAT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="KOTA">
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="KOTA">
          <DataField>KOTA</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT * FROM 
(SELECT  CODE ,
        DESCR KOTA
FROM    PARAM_TBL_KOTA_PROVIDER
UNION
SELECT  '0000000000' ,
        'ALL' KOTA
FROM    PARAM_TBL_KOTA_PROVIDER)
X ORDER BY CODE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="STAT">
      <Fields>
        <Field Name="STAT">
          <DataField>STAT</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>SELECT * FROM(SELECT 2 STAT, 'ALL' DESCR
union 
SELECT CODE STAT, DESCR FROM PR_STATUS_PROVIDER) X ORDER BY STAT DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
