    <DataSet Name="ds_PolicyPeriod">
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PERIODE">
          <DataField>PERIODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select POLICY_PERIOD.ID, PERIODE = convert(varchar(20), POLICY_PERIOD.[START_DATE], 105) + ' s/d ' + convert(varchar(20), POLICY_PERIOD.END_DATE, 105) from POLICY_PERIOD join POLICY on POLICY.ID = POLICY_PERIOD.POLICY_ID join PESERTA_MASTER on PESERTA_MASTER.POLICY_ID = POLICY.ID where PESERTA_MASTER.REGNO = @REGNO</CommandText>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
