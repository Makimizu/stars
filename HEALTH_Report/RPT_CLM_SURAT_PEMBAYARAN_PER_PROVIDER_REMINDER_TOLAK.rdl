                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Sebagaimana dalam surat kami sebelumnya, mengenai informasi masa tenggang waktu selama </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>60 (enam puluh) hari </Value>
                                  <Style>
