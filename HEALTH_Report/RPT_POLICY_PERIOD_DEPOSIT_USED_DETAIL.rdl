    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@POLICY_PERIOD_ID">
            <Value>=Parameters!POLICY_PERIOD_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
POLICY_NO, 
COMPANY_NAME,
PERIOD = convert(varchar(20),START_DATE,106) + ' - ' + convert(varchar(20),END_DATE,106)
from V_POLICY_PERIOD
where
ID = @POLICY_PERIOD_ID</CommandText>
      </Query>
      <Fields>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PERIOD">
          <DataField>PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
