    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@POLICY_PERIOD_ID">
            <Value>=Parameters!POLICY_PERIOD_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TIPE">
            <Value>=Parameters!TIPE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_POLICY_PERIOD_DEPOSIT_USED_DETAIL @POLICY_PERIOD_ID, @TIPE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
