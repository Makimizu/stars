                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox320">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Kami, selaku dokter perusahaan yang diberikan kewenangan oleh PT. </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!NAME.Value</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>, meminta bantuan kepada teman sejawat untuk memberikan informasi dalam bentuk jawaban pertanyaan yang kami lampirkan pada lembaran setelah surat ini.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value />
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                                <LineHeight>12pt</LineHeight>
                              </Style>
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Jawaban atas pertanyaan yang ada pada lembaran tersebut sangat kami perlukan untuk membantu proses penjaminan layanan kesehatan dan analisa klaim peserta asuransi kesehatan PT. </Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!NAME.Value</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>.</Value>
                                  <Style>
                                    <FontStyle>Normal</FontStyle>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>#000000</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                                <LineHeight>12pt</LineHeight>
                              </Style>
