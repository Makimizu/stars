  <DataSources>
    <DataSource Name="PERFMON">
      <DataSourceReference>PERFMON</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>de899859-3c55-4553-b8f1-33c1e87c7a78</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>PERFMON</DataSourceName>
        <CommandText>select 
b.CounterID,
b.CounterName
from CounterData a
inner join CounterDetails b on a.CounterID = b.CounterID
group by
b.CounterID,
b.CounterName
order by 2 desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CounterID">
          <DataField>CounterID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CounterName">
          <DataField>CounterName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="START_DATE">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>START DATE</Prompt>
    </ReportParameter>
    <ReportParameter Name="END_DATE">
      <DataType>DateTime</DataType>
