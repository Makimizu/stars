      <rd:DataSourceID>6d09f234-4ce9-4d46-b541-c2533c311b66</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>PERFMON</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@COUNTER_ID">
            <Value>=Parameters!COUNTER_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_STAT
@COUNTER_ID,
@START_DATE,
@END_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SERVER">
          <DataField>SERVER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DT">
          <DataField>DT</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="VAL">
          <DataField>VAL</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>PERFMON</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@COUNTER_ID">
            <Value>=Parameters!COUNTER_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct
START_DATE = isnull(@START_DATE, convert(date, min(a.CounterTime))),
END_DATE = isnull(@END_DATE, convert(date, max(a.CounterTime)))
from STAT_RECAP a
where
a.CounterID = @COUNTER_ID</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="COUNTER_ID">
      <DataType>String</DataType>
      <Prompt>COUNTER ID</Prompt>
    </ReportParameter>
    <ReportParameter Name="START_DATE">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>START DATE</Prompt>
    </ReportParameter>
    <ReportParameter Name="END_DATE">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>END DATE</Prompt>
    </ReportParameter>
  </ReportParameters>
