  <DataSources>
    <DataSource Name="SECURITY">
      <DataSourceReference>SECURITY</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a046ab60-c642-4848-860c-607fda58479b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>SECURITY</DataSourceName>
        <CommandText>select 
SPID,
CPU,
PHYSICAL_IO,
DURATION,
PROGRAM_NAME,
HOSTNAME,
LOGINNAME,
COMMAND_TYPE
from V_SYS_PROCESS 
order by CPU desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SPID">
          <DataField>SPID</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
