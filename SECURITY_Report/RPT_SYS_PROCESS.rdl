          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PROGRAM_NAME">
          <DataField>PROGRAM_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HOSTNAME">
          <DataField>HOSTNAME</DataField>
