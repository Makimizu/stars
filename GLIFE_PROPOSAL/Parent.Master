    <div style="width: 100%; padding: 10px;">
        <table style="width: 100%; border-bottom: inset; border-width: thin; border-color: darkgrey; color: darkgrey;">
            <tr>
                <td style="font-size: 16pt; text-align: right;">
                    <a href="Welcome.aspx">
                        <span style="font-size: 12pt; color: darkslategray;">Home</span>
                        <i class="fa fa-home" style="color: darkslategray;"></i>
                    </a>
                    &nbsp;|&nbsp;
                    <a href="ChangePassword.aspx">
                        <span style="font-size: 12pt; color: darkslategray;">Security</span>
                        <i class="fas fa-key" style="color: darkslategray;"></i>
