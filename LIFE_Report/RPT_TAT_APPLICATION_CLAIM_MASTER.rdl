    <DataSet Name="DEFAULT_PERIOD">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
DATE_FROM	= convert(date, dateadd(day, 1, dateadd(month, -1, EOMONTH(GETDATE())))),
DATE_TO		= convert(date, EOMONTH(GETDATE()))</CommandText>
      </Query>
      <Fields>
        <Field Name="DATE_FROM">
          <DataField>DATE_FROM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DATE_TO">
          <DataField>DATE_TO</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="STATUS">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select SEQ = null, DESCR = ''
union all
select
SEQ,
DESCR = convert(varchar(10), SEQ) + ' - ' + DESCR
from		PARAM_TRACK
where
TIPE_CODE	= 'CLM'
order by
1</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
