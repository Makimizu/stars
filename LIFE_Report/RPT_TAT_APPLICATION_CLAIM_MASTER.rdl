  <DataSets>
    <DataSet Name="RPT_TAT_APPLICATION_CLAIM_MASTER">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REG_DATE_FROM">
            <Value>=Parameters!REG_DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@REG_DATE_TO">
            <Value>=Parameters!REG_DATE_TO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STATUS">
            <Value>=Parameters!STATUS.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_TAT_APPLICATION_CLAIM_MASTER
@REG_DATE_FROM,
@REG_DATE_TO,
@STATUS</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
