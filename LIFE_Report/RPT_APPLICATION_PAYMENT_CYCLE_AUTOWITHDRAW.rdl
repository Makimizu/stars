  <DataSets>
    <DataSet Name="RPT_APPLICATION_PAYMENT_CYCLE_AUTOWITHDRAW">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_PAYMENT_CYCLE_AUTOWITHDRAW
@YEAR</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
