      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
THEYEAR = YEAR(GETDATE()) - SEQ + 1
from SC_SEQ
where 
SEQ &lt;= 3</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
