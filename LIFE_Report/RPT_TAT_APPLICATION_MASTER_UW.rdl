          <QueryParameter Name="@STATUS">
            <Value>=Parameters!STATUS.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_TAT_APPLICATION_MASTER_UW
@START_DATE,
@END_DATE,
@STATUS</CommandText>
