  <DataSets>
    <DataSet Name="RPT_APPLICATION_UW_PENDING">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_UW_PENDING
@START_DATE,
@END_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
