  <DataSets>
    <DataSet Name="RPT_APPLICATION_PREMIUM_PAYMENT">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@INPUT_DATE_FROM">
            <Value>=Parameters!INPUT_DATE_FROM.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@INPUT_DATE_TO">
            <Value>=Parameters!INPUT_DATE_TO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@INVOICE_TYPE">
            <Value>=Parameters!INVOICE_TYPE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PRODUCT_GROUP">
            <Value>=Parameters!PRODUCT_GROUP.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PRODUCT_NAME">
            <Value>=Parameters!PRODUCT_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CUSTOMER_NAME">
            <Value>=Parameters!CUSTOMER_NAME.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_PREMIUM_PAYMENT
@INPUT_DATE_FROM,
@INPUT_DATE_TO,
@INVOICE_TYPE,
@PRODUCT_GROUP,
@PRODUCT_NAME,
@CUSTOMER_NAME</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="INVOICENO">
          <DataField>INVOICENO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
