          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="INVOICE_TYPE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select INVOICE_TYPE = null, DESCR = '' union all
select INVOICE_TYPE, DESCR from FINANCE.dbo.PARAM_INVOICE_TYPE where APP_ID = 'LF'</CommandText>
      </Query>
      <Fields>
        <Field Name="INVOICE_TYPE">
          <DataField>INVOICE_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_PRODUCT_GROUP">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select CODE = null, DESCR = '' union all
select CODE, DESCR from UWBOX.dbo.PARAM_PRODUCT_GROUP where SEGMENT = 0</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
SOM		= convert(date, convert(varchar(2), MONTH(GETDATE())) + '/1/' + convert(varchar(4), YEAR(GETDATE()))),
EOM		= convert(date, EOMONTH(GETDATE()))</CommandText>
      </Query>
      <Fields>
        <Field Name="SOM">
          <DataField>SOM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EOM">
          <DataField>EOM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
