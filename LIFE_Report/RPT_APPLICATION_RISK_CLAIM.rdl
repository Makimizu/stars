  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="LIFE">
      <DataSourceReference>LIFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ed0d624e-f691-4b26-8832-22217e983e21</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RPT_APPLICATION_RISK_CLAIM">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_RISK_CLAIM
@YEAR,
@MONTH</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="REGNO">
          <DataField>REGNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FULLNAME">
          <DataField>FULLNAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PRODUCT_NAME">
          <DataField>PRODUCT_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="REQUEST_DATE">
          <DataField>REQUEST_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PAYABLE_COMPONENT">
          <DataField>PAYABLE_COMPONENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MODE">
          <DataField>MODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()) - SEQ + 1
from		SC_SEQ
where
SEQ		&lt;= 3
order by 
1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MONTH">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select		CODE = 1,	DESCR = 'January' union all
select		CODE = 2,	DESCR = 'February' union all
select		CODE = 3,	DESCR = 'March' union all
select		CODE = 4,	DESCR = 'April' union all
select		CODE = 5,	DESCR = 'May' union all
select		CODE = 6,	DESCR = 'June' union all
select		CODE = 7,	DESCR = 'July' union all
select		CODE = 8,	DESCR = 'August' union all
select		CODE = 9,	DESCR = 'September' union all
select		CODE = 10,	DESCR = 'October' union all
select		CODE = 11,	DESCR = 'November' union all
select		CODE = 12,	DESCR = 'December' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DEFAULT_PERIOD">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()),
MONTH		= MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MONTH">
          <DataField>MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="YEAR">
      <DataType>Integer</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DEFAULT_PERIOD</DataSetName>
          <ValueField>YEAR</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>YEAR</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>YEAR</DataSetName>
          <ValueField>YEAR</ValueField>
          <LabelField>YEAR</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="MONTH">
      <DataType>Integer</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DEFAULT_PERIOD</DataSetName>
          <ValueField>MONTH</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>MONTH</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>MONTH</DataSetName>
          <ValueField>CODE</ValueField>
          <LabelField>DESCR</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
