    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

POLICY_NO	= a.REGNO,
FULLNAME	= b.FULLNAME,
START_DATE	= a.START_DATE,
END_DATE	= a.END_DATE,
THISCOMPANY	= f.NAME,
THISLOGO	= f.SMALL_LOGO

from		APPLICATION_MASTER a
inner join	V_LINK_CB_MEMBER_MASTER b on a.MEMBER_ID = b.ID
inner join	V_LINK_SC_SC_COMPANY f on f.CODE = '1'
where
a.REGNO = @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="FULLNAME">
          <DataField>FULLNAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="THISCOMPANY">
          <DataField>THISCOMPANY</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="THISLOGO">
          <DataField>THISLOGO</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
