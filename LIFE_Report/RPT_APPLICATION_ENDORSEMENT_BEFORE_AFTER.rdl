    <DataSet Name="RPT_APPLICATION_ENDORSEMENT_BEFORE_AFTER">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SEQ">
            <Value>=Parameters!SEQ.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_ENDORSEMENT_BEFORE_AFTER
@REGNO,
@SEQ</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="MODE">
