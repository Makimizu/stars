    </DataSet>
    <DataSet Name="COMPANY">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
NAME,
SMALL_LOGO
from		V_LINK_SC_SC_COMPANY
where
CODE = 1</CommandText>
      </Query>
      <Fields>
        <Field Name="NAME">
          <DataField>NAME</DataField>
