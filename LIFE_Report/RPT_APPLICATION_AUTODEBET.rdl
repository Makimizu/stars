    <DataSet Name="DEFAULT_VALUES">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
START_DATE = (select CONVERT(DATE,dateadd(dd,-(day(getdate())-1),getdate())) ),
END_DATE = convert(date,(select dateadd(s,-1,dateadd(mm,datediff(m,0,getdate())+1,0))) )</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
