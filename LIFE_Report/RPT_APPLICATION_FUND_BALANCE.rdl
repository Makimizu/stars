  <DataSets>
    <DataSet Name="RPT_APPLICATION_FUND_BALANCE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@STAT">
            <Value>=Parameters!STAT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_FUND_BALANCE
@STAT</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="REGNO">
          <DataField>REGNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FULLNAME">
          <DataField>FULLNAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PRODUCT">
          <DataField>PRODUCT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="STAT">
          <DataField>STAT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FUND">
          <DataField>FUND</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UNIT">
          <DataField>UNIT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CUST_UNIT">
          <DataField>CUST_UNIT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CUST_DATE">
          <DataField>CUST_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="STATUS">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select 
SEQ			= NULL,
DESCR		= 'ALL'

union all

select		
SEQ			= a.SEQ,
DESCR		= a.DESCR
from		PARAM_TRACK a 
where
a.TIPE_CODE	= 'UW'
and a.SEQ &gt;= 4 
and a.SEQ not in (5,99)</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
