          </QueryParameter>
          <QueryParameter Name="@POLICY_NO">
            <Value>=Parameters!POLICY_NO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_TAT_APPLICATION_ENDORSEMENT_MASTER
@START_DATE,
@END_DATE,
@STATUS,
@ENDORSEMENT_TYPE,
@CURRENCY,
@POLICY_NO</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
