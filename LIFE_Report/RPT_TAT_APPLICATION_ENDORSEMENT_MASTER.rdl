    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()) - SEQ + 1
from		SC_SEQ
where
SEQ		&lt;= 3
order by 
1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MONTH">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select		CODE = 1,	DESCR = 'January' union all
select		CODE = 2,	DESCR = 'February' union all
select		CODE = 3,	DESCR = 'March' union all
select		CODE = 4,	DESCR = 'April' union all
select		CODE = 5,	DESCR = 'May' union all
select		CODE = 6,	DESCR = 'June' union all
select		CODE = 7,	DESCR = 'July' union all
select		CODE = 8,	DESCR = 'August' union all
select		CODE = 9,	DESCR = 'September' union all
select		CODE = 10,	DESCR = 'October' union all
select		CODE = 11,	DESCR = 'November' union all
select		CODE = 12,	DESCR = 'December' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DEFAULT_PERIOD">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()),
MONTH		= MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MONTH">
          <DataField>MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="STATUS">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
SEQ = NULL,
DESCR = ''

union all

select
SEQ,
DESCR
from		PARAM_TRACK
where
TIPE_CODE	= 'POS'
and SEQ		in (4,5)
</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DEFAULT_VALUES">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
START_DATE	= dateadd(day,1,EOMONTH(dateadd(month,-1,GETDATE()),1)),
END_DATE	= EOMONTH(GETDATE(),1)</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CURRENCY">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select 
CODE,
DESCR	= REPLACE(CODE,'1','I') + ' - ' + UPPER(DESCR)
from UWBOX.dbo.PR_CURRENCY
order by 
CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ENDORSEMENT_TYPE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select CODE = NULL, DESCR = ''
union all
select		distinct
CODE		= am.CODE,
DESCR		= UPPER(am.DESCR)
from		UWBOX.dbo.PARAM_ENDORSEMENT a 
inner join	UWBOX.dbo.PR_ENDORSEMENT_GROUP am on a.GROUP_CODE = am.CODE
inner join	UWBOX.dbo.PARAM_ENDORSEMENT_MATRIX b on a.CODE = b.ENDORSEMENT_CODE
inner join	UWBOX.dbo.PARAM_PRODUCT_GROUP c on b.PRODUCT_GROUP_CODE = c.CODE and c.SEGMENT = 0

order by 
2</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
