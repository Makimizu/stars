          <DataField>STATUS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CURRENT_PERIOD">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()),
MONTH		= MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MONTH">
          <DataField>MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MONTHS">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select 
SEQ,
DESCR		= dateName(month,DateAdd(month , SEQ, 0 ) - 1)
from		SC_SEQ 
where 
SEQ			&lt;= 12
order by
SEQ</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="STATUS">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select STAT = null, DESCR = '' union all
select STAT = 0, DESCR = 'PENDING' union all
select STAT = 1, DESCR = 'SUCCESS' union all
select STAT = 2, DESCR = 'FAILED' </CommandText>
      </Query>
      <Fields>
        <Field Name="STAT">
          <DataField>STAT</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
