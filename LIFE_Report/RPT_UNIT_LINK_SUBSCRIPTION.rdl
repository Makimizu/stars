  <DataSets>
    <DataSet Name="RPT_UNIT_LINK_SUBSCRIPTION">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STAT">
            <Value>=Parameters!STAT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_UNIT_LINK_SUBSCRIPTION
@YEAR,
@MONTH,
@STAT</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
