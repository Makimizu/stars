  <DataSets>
    <DataSet Name="RPT_APPLICATION_ENDORSEMENT_DETAIL">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SEQ">
            <Value>=Parameters!SEQ.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_ENDORSEMENT_DETAIL
@REGNO,
@SEQ</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ENDORSEMENT">
          <DataField>ENDORSEMENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PARAMETER">
          <DataField>PARAMETER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OLD_VAL">
          <DataField>OLD_VAL</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NEW_VAL">
          <DataField>NEW_VAL</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="HEADER">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
INSURANCE_NAME	= aa.NAME,
INSURANCE_LOGO	= aa.SMALL_LOGO,
POLICY_NO		= a.POLICY_NO,
POLICY_HOLDER	= a.FULLNAME,
PRODUCT			= a.PRODUCT_NAME

from		V_APPLICATION_MASTER a
inner join	V_LINK_SC_SC_COMPANY aa on aa.CODE = '1'
where
a.REGNO = @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="INSURANCE_NAME">
          <DataField>INSURANCE_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INSURANCE_LOGO">
          <DataField>INSURANCE_LOGO</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
        <Field Name="POLICY_NO">
          <DataField>POLICY_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLICY_HOLDER">
          <DataField>POLICY_HOLDER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PRODUCT">
          <DataField>PRODUCT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
