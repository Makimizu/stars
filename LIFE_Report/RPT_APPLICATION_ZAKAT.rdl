                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!CHARGE.Value * ((Sum(Fields!TOTAL_AMOUNT.Value) / 365) * (Fields!RATE.Value / 100)) / Fields!TOTAL_ZAKAT.Value</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
