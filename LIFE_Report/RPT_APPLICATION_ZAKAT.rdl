    <DataSet Name="THEYEAR">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select distinct
THEYEAR			= YEAR(THEDATE)
from			APPLICATION_NISAB
order by 
1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
