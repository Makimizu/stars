  <DataSets>
    <DataSet Name="RPT_APPLICATION_ZAKAT">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ELIGIBLE">
            <Value>=Parameters!ELIGIBLE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_ZAKAT
@YEAR,
@ELIGIBLE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
