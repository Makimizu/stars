    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RPT_SUMMARY_PRODUCT_GROUP_LAST_BALANCE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PRODUCT_GROUP">
            <Value>=Parameters!PRODUCT_GROUP.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EFF_DATE">
            <Value>=Parameters!EFF_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_SUMMARY_PRODUCT_GROUP_LAST_BALANCE
@PRODUCT_GROUP,
@EFF_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EFF_DATE">
          <DataField>EFF_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PRODUCT_GROUP">
          <DataField>PRODUCT_GROUP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BALANCE">
          <DataField>BALANCE</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EFF_DATE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select EFF_DATE = convert(varchar(15),EOMONTH(dateadd(month,-1,GETDATE())),106)
union all
select EFF_DATE = convert(varchar(15),EOMONTH(dateadd(month,-2,GETDATE())),106)
union all
select EFF_DATE = convert(varchar(15),EOMONTH(dateadd(month,-3,GETDATE())),106)</CommandText>
      </Query>
      <Fields>
        <Field Name="EFF_DATE">
          <DataField>EFF_DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PRODUCT_GROUP">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select CODE,DESCR from UWBOX.dbo.PR_PRODUCT_GROUP where CODE = 'ISP'</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DEFAULT_VALUES">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select 
PRODUCT_GROUP = 'ISP',
EFF_DATE = convert(varchar(15),EOMONTH(dateadd(month,-1,GETDATE())),106)</CommandText>
      </Query>
      <Fields>
        <Field Name="PRODUCT_GROUP">
          <DataField>PRODUCT_GROUP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EFF_DATE">
          <DataField>EFF_DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
