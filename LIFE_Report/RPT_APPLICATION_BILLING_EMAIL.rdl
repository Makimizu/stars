  <DataSets>
    <DataSet Name="RPT_APPLICATION_BILLING_EMAIL">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_BILLING_EMAIL 
@YEAR,
@MONTH</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EMAIL">
          <DataField>EMAIL</DataField>
          <rd:TypeName>System.String</rd:TypeName>
