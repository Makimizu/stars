    <DataSet Name="IS_UNITIZE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select		a.REGNO
from		APPLICATION_MASTER a
inner join	UWBOX.dbo.V_PARAM_PRODUCT_MASTER b on a.PRODUCT_CODE = b.PRODUCT_CODE and b.UNITIZE = 1
where
a.REGNO = @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="REGNO">
          <DataField>REGNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
