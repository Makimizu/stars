  </DataSources>
  <DataSets>
    <DataSet Name="RPT_APPLICATION_REINSTATEMENT">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_REINSTATEMENT 
@START_DATE,
@END_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="REGDATE">
          <DataField>REGDATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RO">
          <DataField>RO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
