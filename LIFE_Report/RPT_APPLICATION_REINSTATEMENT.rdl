          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLICY_HOLDER">
          <DataField>POLICY_HOLDER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LAST_CYCLE_DATE">
          <DataField>LAST_CYCLE_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LAST_COI_DATE">
          <DataField>LAST_COI_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="VERIFY_DATE">
