        </Field>
        <Field Name="LOADING">
          <DataField>LOADING</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="POLICY_CHARGE">
          <DataField>POLICY_CHARGE</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PAYMENT_DATE">
