        <CommandText>select INVOICE_TYPE = null, DESCR = '' union all
select INVOICE_TYPE, DESCR from FINANCE.dbo.PARAM_INVOICE_TYPE where APP_ID = 'LF'</CommandText>
      </Query>
      <Fields>
