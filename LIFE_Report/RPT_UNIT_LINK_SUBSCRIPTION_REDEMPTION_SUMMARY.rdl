  <DataSources>
    <DataSource Name="LIFE">
      <DataSourceReference>LIFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>54c85fa5-d07e-4acc-9f56-893dc15484b3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RPT_UNIT_LINK_SUBSCRIPTION_REDEMPTION_SUMMARY">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APPROVAL_DATE">
            <Value>=Parameters!APPROVAL_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_UNIT_LINK_SUBSCRIPTION_REDEMPTION_SUMMARY
@APPROVAL_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TRANSACTION_GROUP">
          <DataField>TRANSACTION_GROUP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TRANSACTION_TYPE">
          <DataField>TRANSACTION_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="STATUS">
          <DataField>STATUS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="APPROVAL_DATE">
          <DataField>APPROVAL_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NAV_DATE">
          <DataField>NAV_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="UNIT">
          <DataField>UNIT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CASES">
          <DataField>CASES</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CURRENT_PERIOD">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()),
MONTH		= MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MONTH">
          <DataField>MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MONTHS">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandText>select 
SEQ,
DESCR		= dateName(month,DateAdd(month , SEQ, 0 ) - 1)
from		SC_SEQ 
where 
SEQ			&lt;= 12
order by
SEQ</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="APPROVAL_DATE">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct
CODE		= convert(date, a.APPROVAL_DATE),
DESCR		= convert(varchar(20), a.APPROVAL_DATE, 106)
from		V_SAVING_SUBSCRIPTION_REDEMPTION_SUMMARY a
where
YEAR(a.APPROVAL_DATE) = @YEAR
and MONTH(a.APPROVAL_DATE) = @MONTH
order by
a.APPROVAL_DATE desc</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
