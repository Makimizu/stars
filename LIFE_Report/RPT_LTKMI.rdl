                  <TextRun>
                    <Value>Lampiran 5 - Laporan Transaksi Keuangan Mencurigakan Internal (LTKMI)</Value>
                    <Style>
                      <FontFamily>Verdana</FontFamily>
                      <FontWeight>Bold</FontWeight>
