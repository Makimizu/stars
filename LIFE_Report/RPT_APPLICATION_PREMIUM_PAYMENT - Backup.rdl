      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_APPLICATION_PREMIUM_PAYMENT
@INPUT_DATE_FROM,
@INPUT_DATE_TO,
@INVOICE_TYPE,
@PRODUCT_GROUP,
@PRODUCT_NAME,
@CUSTOMER_NAME</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
