    <DataSet Name="SUMINS_PARAMETERIZED_SERIES">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
START_DATE			= a.START_DATE,
PERIOD				= dbo.UFN_SET_INDO_DATE(a.START_DATE) + ' - ' + dbo.UFN_SET_INDO_DATE(a.END_DATE),
SUMINS				= a.SUMINS
from				V_APPLICATION_SUMINS_PARAMETERIZED_SERIES a
where
a.REGNO				= @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PERIOD">
          <DataField>PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUMINS">
          <DataField>SUMINS</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="REMARK">
      <Query>
        <DataSourceName>LIFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SEQ">
            <Value>=Parameters!SEQ.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
REMARK		= (case when NEXT_RENEWAL_DATE is not null then 'Ilustrasi ini dibuat untuk diberlakukan di tanggal ' + dbo.UFN_SET_INDO_DATE(NEXT_RENEWAL_DATE)
					else 'Ilustrasi ini sudah EXPIRED' 
					end)
from		V_APPLICATION_ENDORSEMENT_PARENT
where
REGNO		= @REGNO
and SEQ		= @SEQ</CommandText>
      </Query>
      <Fields>
        <Field Name="REMARK">
          <DataField>REMARK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
