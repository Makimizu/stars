    <DataSet Name="RPT_APPLICATION_QUOTATION_FHP">
      <Query>
        <DataSourceName>LQ</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BENEFIT_CODE">
            <Value>=Parameters!BENEFIT_CODE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_APPLICATION_QUOTATION_FHP
@REGNO,
@BENEFIT_CODE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
