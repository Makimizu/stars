    <DataSet Name="RPT_APPLICATION_QUOTATION_FHP_FOOTER">
      <Query>
        <DataSourceName>LQ</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BENEFIT_CODE">
            <Value>=Parameters!BENEFIT_CODE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select DESCR = (case when @BENEFIT_CODE = 'OP' then		'*) Tanggungan sendiri (Co-Insurance) 20% &lt;BR&gt;**) Dapat langsung mendapat perawatan dari dr.Spesialis'
					 when @BENEFIT_CODE = 'DT' then		'*) Tanggungan sendiri (Co-Insurance) 20%'
					 else ''
					 end)</CommandText>
      </Query>
      <Fields>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
