    <DataSet Name="PRODUCT">
      <Query>
        <DataSourceName>LQ</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REGNO">
            <Value>=Parameters!REGNO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
PRODUCT_NAME	= UPPER(b.PRODUCT_DESCR),
COMPANY_NAME	= c.NAME,
LOGO			= c.BIG_LOGO,
AGENT_NAME			= replace(LTRIM(RTRIM(isnull(vag.FRONT_NAME, '') + ' ' + isnull(vag.MID_NAME, '') + ' ' + isnull(vag.LAST_NAME, ''))), '  ', ' '),
STAMP_DATE			= GETDATE()
from		APPLICATION_MASTER a
inner join	V_LINK_UW_PARAM_PRODUCT_MASTER b on a.PRODUCT_CODE = b.PRODUCT_CODE
inner join	V_LINK_SC_COMPANY c on c.CODE = '1'
left join	APPLICATION_AGENT ag on a.REGNO = ag.REGNO and ag.COMMISSION_TYPE = 'COMM'
left join	V_LINK_MARKETING_M_AGENTS vag on ag.AGENT_CODE = vag.CODE collate database_default
where
a.ReGNO = @REGNO</CommandText>
      </Query>
      <Fields>
        <Field Name="PRODUCT_NAME">
          <DataField>PRODUCT_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMPANY_NAME">
          <DataField>COMPANY_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOGO">
          <DataField>LOGO</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
        <Field Name="AGENT_NAME">
          <DataField>AGENT_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="STAMP_DATE">
          <DataField>STAMP_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
