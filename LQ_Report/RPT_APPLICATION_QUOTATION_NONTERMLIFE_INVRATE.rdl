                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Sum(Fields!RATE.Value) is nothing,"***",Sum(Fields!RATE.Value))</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Format>#,0;(#,0)</Format>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>=IIF(Fields!RATE.Value &lt; 0, "Red", "Black")</Color>
