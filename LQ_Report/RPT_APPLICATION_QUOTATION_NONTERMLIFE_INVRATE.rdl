                            <Paragraphs>
                              <Paragraph>
                                <TextRuns>
                                  <TextRun>
                                    <Value>=IIF(Fields!RATE_PCT.Value like "*Rendah", Replace(Replace(Replace(Fields!RATE_PCT.Value,"1",""),"2",""),"3",""), Fields!RATE_PCT.Value)</Value>
