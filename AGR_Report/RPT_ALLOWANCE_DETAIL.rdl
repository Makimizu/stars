  <DataSets>
    <DataSet Name="PARAM_REMUN_ALLOWANCE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AGENTCODE">
            <Value>=Parameters!AGENTCODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STARTDATE">
            <Value>=Parameters!STARTDATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ENDDATE">
            <Value>=Parameters!ENDDATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct 
a.AGENT_CODE,
c.YEAR,
B.SUBCD_DESCR,
MIN_AMOUNT,
MAX_AMOUNT,
FIX_AMOUNT 
from		PERIOD_DETAIL a
inner join	V_M_AGENTS b on b.CODE = a.AGENT_CODE
left join	PARAM_REMUN_ALLOWANCE c on c.MARKET_SEGMENT = a.CD and c.LEVEL = b.SUBCD
where 
a.AGENT_CODE = @AGENTCODE 
and a.START_DATE = @STARTDATE 
AND A.END_DATE = @ENDDATE</CommandText>
      </Query>
      <Fields>
        <Field Name="AGENT_CODE">
          <DataField>AGENT_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUBCD_DESCR">
          <DataField>SUBCD_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MIN_AMOUNT">
          <DataField>MIN_AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="MAX_AMOUNT">
          <DataField>MAX_AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FIX_AMOUNT">
          <DataField>FIX_AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RPT_ALLOWANCE_DETAIL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AGENTCODE">
            <Value>=Parameters!AGENTCODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STARTDATE">
            <Value>=Parameters!STARTDATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ENDDATE">
            <Value>=Parameters!ENDDATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_ALLOWANCE_DETAIL
@AGENTCODE,
@STARTDATE,
@ENDDATE</CommandText>
      </Query>
      <Fields>
        <Field Name="COMM_TYPE">
          <DataField>COMM_TYPE</DataField>
