  <DataSources>
    <DataSource Name="AGR">
      <DataSourceReference>AGR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5d60162a-ed7f-437f-b0bd-ac81d8b5fd7e</rd:DataSourceID>
    </DataSource>
