  <DataSets>
    <DataSet Name="RPT_HOLD_REMUN">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REQUESTBY">
            <Value>=Parameters!REQUESTBY.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PERIODCOUNT">
            <Value>=Parameters!PERIODCOUNT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_HOLD_REMUN 
@REQUESTBY,
@PERIODCOUNT</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="AGENT_CODE">
