    <DataSet Name="REQUESTBY">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE = '',DESCR = 'ALL'
union all
select CODE = 'SYSTEM',DESCR = 'SYSTEM'</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIODCOUNT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE = '0', DESCR = 'ALL'
union all
select CODE = '1', DESCR = '&gt;0'

</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
