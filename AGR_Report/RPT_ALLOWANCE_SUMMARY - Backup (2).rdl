      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_ALLOWANCE_SUMMARY
@AGENT_CODE,
@START_DATE,
@END_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@AGENT_CODE">
            <Value>=Parameters!AGENT_CODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
