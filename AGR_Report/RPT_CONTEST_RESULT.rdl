    <DataSet Name="SCHEME">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
ID,
DESCR
from			CONTEST_MASTER
order by
START_DATE desc</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TITLE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
DESCR,
START_DATE,
END_DATE
from			CONTEST_MASTER
where
ID				= @ID</CommandText>
      </Query>
      <Fields>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ACHIEVEMENT_TYPE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
select
ACHIEVEMENT_TYPE	= b.DESCR
from			CONTEST_PARAMETER_GENERAL a
inner join			PR_ACHIEVEMENT_TYPE b on a.VAL = b.CODE collate database_default
where
a.FIELD_CODE		= 'CONGR07'
and a.ID			= @ID</CommandText>
      </Query>
      <Fields>
        <Field Name="ACHIEVEMENT_TYPE">
          <DataField>ACHIEVEMENT_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
