          <DataField>ACC_SOURCE_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ACC_SOURCE_NAME">
          <DataField>ACC_SOURCE_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
THEYEAR		= YEAR(GETDATE()) - SEQ + 1
from		SC_SEQ
where
SEQ			&lt;= 3</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="THEMONTH">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>
select 
SEQ			= SEQ,
MON			= (case when SEQ = 1 then 'JANUARY'
					when SEQ = 2 then 'FEBRUARY'
					when SEQ = 3 then 'MARCH'
					when SEQ = 4 then 'APRIL'
					when SEQ = 5 then 'MAY'
					when SEQ = 6 then 'JUNE'
					when SEQ = 7 then 'JULY'
					when SEQ = 8 then 'AUGUST'
					when SEQ = 9 then 'SEPTEMBER'
					when SEQ = 10 then 'OCTOBER'
					when SEQ = 11 then 'NOVEMBER'
					when SEQ = 12 then 'DECEMBER'
					else ''
					end)
from		SC_SEQ
where
SEQ			&lt;= 12</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MON">
          <DataField>MON</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
PERIOD		= (case when @MONTH = 1 then 'JANUARY'
					when @MONTH = 2 then 'FEBRUARY'
					when @MONTH = 3 then 'MARCH'
					when @MONTH = 4 then 'APRIL'
					when @MONTH = 5 then 'MAY'
					when @MONTH = 6 then 'JUNE'
					when @MONTH = 7 then 'JULY'
					when @MONTH = 8 then 'AUGUST'
					when @MONTH = 9 then 'SEPTEMBER'
					when @MONTH = 10 then 'OCTOBER'
					when @MONTH = 11 then 'NOVEMBER'
					when @MONTH = 12 then 'DECEMBER'
					else ''
					end) + ' ' + convert(varchar(10), @YEAR)</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIOD">
          <DataField>PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DEFAULT_MONTH">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select MON = MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="MON">
          <DataField>MON</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
