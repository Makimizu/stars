  <DataSets>
    <DataSet Name="RPT_GL_REMUNERATION_PAYMENT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_GL_REMUNERATION_PAYMENT
@YEAR,
@MONTH</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DOCNO">
          <DataField>DOCNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POST_DATE">
          <DataField>POST_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
