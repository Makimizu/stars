    <DataSet Name="THEYEAR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
THEYEAR		= YEAR(GETDATE()) - a.SEQ + 1
from		SC_SEQ a
where
a.SEQ &lt;= 3
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MARKET_SEGMENT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE, DESCR from PR_MARKET_SEGMENT</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
