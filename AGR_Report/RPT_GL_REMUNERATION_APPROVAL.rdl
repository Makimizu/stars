  <DataSets>
    <DataSet Name="RPT_GL_REMUNERATION_APPROVAL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_GL_REMUNERATION_APPROVAL
@YEAR,
@MONTH</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DOCNO">
          <DataField>DOCNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
