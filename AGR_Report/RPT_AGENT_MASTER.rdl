  <DataSets>
    <DataSet Name="MARKET_SEGMENT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE, DESCR from PR_MARKET_SEGMENT</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="STATUS">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE = 1, DESCR = 'ACTIVE' union all
select CODE = 0, DESCR = 'NOT ACTIVE' union all
select CODE = null, DESCR = 'ALL STATUS' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RPT_AGENT_MASTER">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STATUS">
            <Value>=Parameters!STATUS.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AGENCY_NAME">
            <Value>=Parameters!AGENCY_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RO_NAME">
            <Value>=Parameters!RO_NAME.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_AGENT_MASTER
@MARKET_SEGMENT,
@STATUS,
@AGENCY_NAME,
@RO_NAME</CommandText>
