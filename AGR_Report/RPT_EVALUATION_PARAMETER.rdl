  <DataSets>
    <DataSet Name="RPT_EVALUATION_PARAMETER">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_EVALUATION_PARAMETER
@ID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="MODE">
          <DataField>MODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
