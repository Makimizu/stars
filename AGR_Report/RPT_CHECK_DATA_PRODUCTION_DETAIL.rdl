    <DataSet Name="NOTIFY">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PERIOD">
            <Value>=Parameters!PERIOD.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        REMARK, COUNT(*) AS CNTREC
FROM            V_RPT_CHECK_DATA_PRODUCTION
WHERE        (MARKET_SEGMENT = @MARKET_SEGMENT) AND (START_DATE = SUBSTRING(@PERIOD, 1, 10)) AND (END_DATE = SUBSTRING(@PERIOD, 14, 10))
GROUP BY REMARK
ORDER BY REMARK</CommandText>
      </Query>
      <Fields>
        <Field Name="REMARK">
          <DataField>REMARK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CNTREC">
          <DataField>CNTREC</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CHANNEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE,DESCR from PR_MARKET_SEGMENT
order by code</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CONVERT(varchar(10), START_DATE) + ' - ' + CONVERT(varchar(10), END_DATE) AS period
FROM            PERIOD_MASTER
WHERE        (CD = @MARKET_SEGMENT) AND (REMUN_TYPE = '1') AND (END_DATE &lt;= GETDATE())
ORDER BY START_DATE DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="period">
          <DataField>period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="MARKET_SEGMENT">
      <DataType>String</DataType>
      <Prompt>DIVISI IN CHARGE</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>CHANNEL</DataSetName>
          <ValueField>CODE</ValueField>
          <LabelField>DESCR</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="PERIOD">
      <DataType>String</DataType>
      <Prompt>PERIOD</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>PERIOD</DataSetName>
          <ValueField>period</ValueField>
          <LabelField>period</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="REMARK">
      <DataType>String</DataType>
      <Prompt>REMARK</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>NOTIFY</DataSetName>
          <ValueField>REMARK</ValueField>
          <LabelField>REMARK</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
