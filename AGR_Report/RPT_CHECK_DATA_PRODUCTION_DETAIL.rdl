          <QueryParameter Name="@REMARK">
            <Value>=Parameters!REMARK.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>IF (@REFERENCE_NO = '')
BEGIN
select * from V_RPT_CHECK_DATA_PRODUCTION
where MARKET_SEGMENT = @MARKET_SEGMENT
and START_DATE = substring(@PERIOD,1,10)
and END_DATE = substring(@PERIOD,14,10)
and REMARK = @REMARK
order by year,reference_no,settledate,due_date
END
ELSE BEGIN 
select * from V_RPT_CHECK_DATA_PRODUCTION
where MARKET_SEGMENT = @MARKET_SEGMENT 
and START_DATE = substring(@PERIOD,1,10)
and END_DATE = substring(@PERIOD,14,10)
and REFERENCE_NO= @REFERENCE_NO
order by year,reference_no,settledate,due_date
END</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
