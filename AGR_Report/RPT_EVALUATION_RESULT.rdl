<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AGR">
      <DataSourceReference>AGR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>274eb643-f3f4-482a-97cb-f9fb80758ac7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SCHEME">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
ID,
DESCR
from			EVALUATION_MASTER
order by
START_DATE desc</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TITLE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
DESCR,
START_DATE,
END_DATE
from			EVALUATION_MASTER
where
ID				= @ID</CommandText>
      </Query>
      <Fields>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AGENT_LEVEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct
CODE			= b.SUB_CODE,
DESCR			= c.DESCR + ' - ' + b.DESCR,
MARKET_SEGMENT	= b.MARKET_SEGMENT,
SEQ				= b.SEQ
from			EVALUATION_PARAMETER a
inner join		PARAM_SUB_CHANNEL_DISTRIBUTION b on a.CURRENT_AGENT_LEVEL = b.SUB_CODE
inner join		PR_MARKET_SEGMENT c on b.MARKET_SEGMENT = c.CODE
where
a.ID			= @ID
order by
b.MARKET_SEGMENT,
b.SEQ</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MARKET_SEGMENT">
          <DataField>MARKET_SEGMENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RPT_EVALUATION_RESULT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AGENT_LEVEL">
            <Value>=Parameters!AGENT_LEVEL.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_EVALUATION_RESULT
@ID,
@AGENT_LEVEL</CommandText>
      </Query>
