    <DataSet Name="ACHIEVEMENT_TYPE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
select
ACHIEVEMENT_TYPE	= b.DESCR
from				EVALUATION_PARAMETER_GENERAL a
inner join			PR_ACHIEVEMENT_TYPE b on a.VAL = b.CODE collate database_default
where
a.FIELD_CODE		= 'EVAGR07'
and a.ID			= @ID</CommandText>
      </Query>
      <Fields>
        <Field Name="ACHIEVEMENT_TYPE">
          <DataField>ACHIEVEMENT_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
