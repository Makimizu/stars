    <DataSet Name="PRODUCT_GROUP">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        '' AS CODE, 'ALL' AS DESCR
UNION ALL
SELECT        CODE, DESCR
FROM            V_LINK_UB_PR_PRODUCT_GROUP
ORDER BY DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TRANSTYPE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        '' AS CODE, 'ALL' AS DESCR
UNION ALL
SELECT        CODE, DESCR
FROM            PR_TRANS_TYPE
ORDER BY CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CHANNEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT 
CODE=null,
DESCR = ''

union all

SELECT        
CODE, 
DESCR
FROM            PR_MARKET_SEGMENT

ORDER BY 1</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LEVEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        
SUB_CODE	= '',
DESCR		=  'ALL'
UNION ALL
SELECT        
SUB_CODE, 
DESCR
FROM        PARAM_SUB_CHANNEL_DISTRIBUTION
where
MARKET_SEGMENT = @MARKET_SEGMENT
ORDER BY 
SUB_CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="SUB_CODE">
          <DataField>SUB_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
YEAR = YEAR(GETDATE()) - a.SEQ + 1
from SC_SEQ a
where
a.SEQ &lt;= 3
order by
1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MONTH">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>
select 
CODE	= SEQ, 
DESCR	= UPPER(DateName( month , DateAdd( month , SEQ , -1 ))) 
from	SC_SEQ  
where  
SEQ		&lt;= 12</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CURRENTMONTH">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>
select 
THISYEAR	= YEAR(GETDATE()),
THISMONTH	= MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="THISYEAR">
          <DataField>THISYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="THISMONTH">
          <DataField>THISMONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DATES">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
select
THEDATE		= dateadd(day, b.SEQ-1,  a.FIRSTDAY),
DESCR		= convert(varchar(20), dateadd(day, b.SEQ-1,  a.FIRSTDAY), 106)
from		(	select
				FIRSTDAY	= convert(date, convert(varchar(4), @YEAR) + RIGHT('0' + convert(varchar(2), @MONTH), 2) + '01'),
				EOM			= EOMONTH(convert(date, convert(varchar(4), @YEAR) + RIGHT('0' + convert(varchar(2), @MONTH), 2) + '01'))
			) a
inner join	SC_SEQ b on b.SEQ &lt;= datediff(day, a.FIRSTDAY, a.EOM) + 1</CommandText>
      </Query>
      <Fields>
        <Field Name="THEDATE">
          <DataField>THEDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
