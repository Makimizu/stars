        <CommandType>Text</CommandType>
        <CommandText>exec RPT_AGENT_PROMOTION
@PROMOTING_AGENT,
@PROMOTED_AGENT,
@PROMOTED_LEVEL</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
