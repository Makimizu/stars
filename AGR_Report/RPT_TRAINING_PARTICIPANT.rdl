    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT 
PERIOD_FROM	= convert(date, DATEADD(yy, DATEDIFF(yy, 0, GETDATE()), 0)),
PERIOD_TO	= convert(date, GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIOD_FROM">
          <DataField>PERIOD_FROM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PERIOD_TO">
