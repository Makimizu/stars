  <DataSets>
    <DataSet Name="MARKET_SEGMENT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE, DESCR from PR_MARKET_SEGMENT where DESCR not like '%2'</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LEVEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select SUB_CODE = '', DESCR = '' union all
select SUB_CODE, DESCR = UPPER(DESCR) from PARAM_SUB_CHANNEL_DISTRIBUTION where MARKET_SEGMENT = @MARKET_SEGMENT</CommandText>
      </Query>
      <Fields>
        <Field Name="SUB_CODE">
          <DataField>SUB_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RPT_AGENT_STRUCTURE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@LEVEL">
            <Value>=Parameters!LEVEL.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_AGENT_STRUCTURE
@MARKET_SEGMENT,
@LEVEL</CommandText>
      </Query>
