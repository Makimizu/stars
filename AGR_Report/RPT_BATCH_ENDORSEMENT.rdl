    <DataSet Name="TITLE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
ENDORSEMENT_TYPE	= ENDORSEMENT_TYPE_DESCR,
SUBMISSION_BY= CREATEBY,
SUBMISSION_DATE = CREATEDATE,
DECISION			= DECISION_DESCR,
AUTH_BY				= AUTH_BY,
AUTH_DATE			= AUTH_DATE
from				V_BATCH_ENDORSEMENT
where
BATCH_ID			= @ID
</CommandText>
      </Query>
      <Fields>
        <Field Name="ENDORSEMENT_TYPE">
