    </DataSet>
    <DataSet Name="THEYEAR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
THEYEAR		= YEAR(GETDATE()) - a.SEQ + 1
from		SC_SEQ a
where
a.SEQ &lt;= 3
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
