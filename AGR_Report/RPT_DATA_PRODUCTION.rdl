    <DataSet Name="PRODUCT_GROUP">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        '' AS CODE, 'ALL' AS DESCR
UNION ALL
SELECT        CODE, DESCR
FROM            V_LINK_UB_PR_PRODUCT_GROUP
ORDER BY DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TRANSTYPE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        '' AS CODE, 'ALL' AS DESCR
UNION ALL
SELECT        CODE, DESCR
FROM            PR_TRANS_TYPE
ORDER BY CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CHANNEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        CODE, DESCR
FROM            PR_MARKET_SEGMENT
ORDER BY 2</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LEVEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        '' AS CD_CODE, 'ALL' AS DESCR
UNION ALL
SELECT        CD_CODE, DESCR
FROM            PARAM_SUB_CHANNEL_DISTRIBUTION
ORDER BY CD_CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="CD_CODE">
          <DataField>CD_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT
START_DATE = DATEADD(yy, DATEDIFF(yy, 0, GETDATE()), 0),
END_DATE = DATEADD(yy, DATEDIFF(yy, 0, GETDATE()) + 1, -1)</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="STAT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE = 0, DESCR = 'UNCOMPLETE' union all
select CODE = 1, DESCR = 'COMPLETE'</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
