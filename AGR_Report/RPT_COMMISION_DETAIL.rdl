    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
PERIOD_FROM	= convert(date, dateadd(day, 1, dateadd(month, -1, EOMONTH(GETDATE())))),
PERIOD_TO	= convert(date, EOMONTH(GETDATE()))</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIOD_FROM">
          <DataField>PERIOD_FROM</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PERIOD_TO">
          <DataField>PERIOD_TO</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="POLICY_NO">
      <DataType>String</DataType>
      <AllowBlank>true</AllowBlank>
      <Prompt>POLICY NO</Prompt>
    </ReportParameter>
    <ReportParameter Name="PERIOD_START">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>PERIOD</DataSetName>
          <ValueField>PERIOD_FROM</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>PERIOD START</Prompt>
    </ReportParameter>
    <ReportParameter Name="AGENT_NAME">
      <DataType>String</DataType>
