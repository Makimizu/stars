    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RPT_FINANCE_SETTLEMENT_DETAIL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PAYMENT_TYPE">
            <Value>=Parameters!PAYMENT_TYPE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CHANNEL">
            <Value>=Parameters!CHANNEL.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AGENCY_NAME">
            <Value>=Parameters!AGENCY_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AGENT_NAME">
            <Value>=Parameters!AGENT_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PAID">
            <Value>=Parameters!PAID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_FINANCE_SETTLEMENT_DETAIL
@PAYMENT_TYPE,
@CHANNEL,
@YEAR,
@AGENCY_NAME,
@AGENT_NAME,
@PAID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PAYMENT_TYPE">
          <DataField>PAYMENT_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PERIOD">
          <DataField>PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AGENT_CODE">
          <DataField>AGENT_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AGENT_NAME">
          <DataField>AGENT_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CHANNEL_DESCR">
          <DataField>CHANNEL_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LEVEL">
          <DataField>LEVEL</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AGENCY">
          <DataField>AGENCY</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
