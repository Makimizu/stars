          <DataField>ACC_NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BANK">
          <DataField>BANK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FINANCE_DOCNO">
          <DataField>FINANCE_DOCNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="REQUEST_DATE">
          <DataField>REQUEST_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PAYMENT_DATE">
          <DataField>PAYMENT_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PAYMENT_RK">
          <DataField>PAYMENT_RK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PAYMENT_TYPE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE, DESCR from FINANCE.dbo.PARAM_TIPE_SETTLEMENT where APP_ID = 'AGR'</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CHANNEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT        CODE, DESCR
FROM            PR_MARKET_SEGMENT
ORDER BY DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()) - SEQ + 1
from		SC_SEQ a
where
a.SEQ &lt;= 3
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
