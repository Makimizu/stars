    <DataSet Name="TITLE">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
DESCR		= UPPER(DESCR),
PERIOD		= convert(varchar(20), START_DATE, 106) + ' - ' + convert(varchar(20), END_DATE, 106)
from		CONTEST_MASTER 
where 
ID			= @ID</CommandText>
      </Query>
      <Fields>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PERIOD">
          <DataField>PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
