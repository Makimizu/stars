    <DataSet Name="PERIOD_DESCR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PERIOD">
            <Value>=Parameters!PERIOD.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
PERIOD	= convert(varchar(20), convert(date, LEFT(@PERIOD, 8)), 106) + ' - ' + convert(varchar(20), convert(date, RIGHT(@PERIOD, 8)), 106)</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIOD">
          <DataField>PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
CODE		= convert(varchar(20), START_DATE, 112) + convert(varchar(20), END_DATE, 112),
DESCR		= convert(varchar(20), START_DATE, 106) + ' - ' + convert(varchar(20), END_DATE, 106)
from		PERIOD_DETAIL a
inner join	SC_SEQ c on c.SEQ &lt;= 2
inner join	(	select THEYEAR = MAX(YEAR(START_DATE)) from PERIOD_DETAIL ) b on YEAR(a.START_DATE) = b.THEYEAR - c.SEQ + 1
group by
a.START_DATE,
a.END_DATE
order by
a.START_DATE desc</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CHANNEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE, DESCR from PR_MARKET_SEGMENT order by 2</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
