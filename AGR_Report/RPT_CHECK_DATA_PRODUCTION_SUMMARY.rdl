  <DataSources>
    <DataSource Name="AGR">
      <DataSourceReference>AGR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8974b276-dbc9-4f0e-a647-3eb52a4766fb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="V_RPT_CHECK_DATA_PRODUCTION_SUMMARY">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PERIOD">
            <Value>=Parameters!PERIOD.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
MARKET_SEGMENT,
MARKET_SEGMENT_DESCR,
START_DATE,
END_DATE,
REMARK,
count(*) RECRD 
from V_RPT_CHECK_DATA_PRODUCTION

where MARKET_SEGMENT= @MARKET_SEGMENT 
and START_DATE = substring(@PERIOD,1,10) 
and END_DATE = substring(@PERIOD,14,10)

group by 
MARKET_SEGMENT,
MARKET_SEGMENT_DESCR,
START_DATE,
END_DATE,
REMARK</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="MARKET_SEGMENT">
          <DataField>MARKET_SEGMENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MARKET_SEGMENT_DESCR">
          <DataField>MARKET_SEGMENT_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="REMARK">
          <DataField>REMARK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RECRD">
          <DataField>RECRD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MARKET_SEGMENT">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE, DESCR from PR_MARKET_SEGMENT
order by CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        CONVERT(varchar(10), START_DATE) + ' - ' + CONVERT(varchar(10), END_DATE) AS period
FROM            PERIOD_MASTER
WHERE        (CD = @MARKET_SEGMENT) AND (REMUN_TYPE = '1') AND (END_DATE &lt;= GETDATE())
ORDER BY START_DATE DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="period">
          <DataField>period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="MARKET_SEGMENT">
      <DataType>String</DataType>
      <Prompt>DIVISI IN CHARGE</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>MARKET_SEGMENT</DataSetName>
          <ValueField>CODE</ValueField>
          <LabelField>DESCR</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="PERIOD">
      <DataType>String</DataType>
      <Prompt>PERIOD</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>PERIOD</DataSetName>
          <ValueField>period</ValueField>
          <LabelField>period</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
