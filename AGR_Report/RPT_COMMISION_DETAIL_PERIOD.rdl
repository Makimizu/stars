    <DataSet Name="CHANNEL">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select CODE,DESCR from PR_MARKET_SEGMENT
order by code</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CODE</DataField>
        </Field>
        <Field Name="DESCR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DESCR</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MARKET_SEGMENT">
            <Value>=Parameters!MARKET_SEGMENT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT convert(varchar(10),START_DATE) + ' - ' + convert(varchar(10),END_DATE) period FROM PERIOD_MASTER
WHERE CD = @MARKET_SEGMENT 
AND REMUN_TYPE = '1' 
AND MONTH(END_DATE) &lt;= (case when @YEAR &lt; YEAR(GETDATE()) then 12 else MONTH(GETDATE()) end)
and YEAR(START_DATE) = @YEAR
ORDER BY START_DATE DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="period">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>period</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select
THEYEAR		= YEAR(GETDATE()) - sc.SEQ + 1
from		SC_SEQ sc
where
sc.SEQ		&lt;= 3
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>THEYEAR</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
