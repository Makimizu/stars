    <DataSet Name="Bulan">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select '01' as 'ID','Januari' as 'Value' 
union all
select '02' as 'ID','Februari' as 'Value' 
union all
select '03' as 'ID','Maret' as 'Value' 
union all
select '04' as 'ID','April' as 'Value' 
union all
select '05' as 'ID','Mei' as 'Value' 
union all
select '06' as 'ID','Juni' as 'Value' 
union all
select '07' as 'ID','Juli' as 'Value' 
union all
select '08' as 'ID','Agusutus' as 'Value' 
union all
select '09' as 'ID','September' as 'Value' 
union all
select '10' as 'ID','Oktober' as 'Value' 
union all
select '11' as 'ID','November' as 'Value' 
union all
select '12' as 'ID','Desember' as 'Value' 
</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Value">
          <DataField>Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Tahun">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>select distinct
THEYEAR = YEAR(START_DATE)
from	V_PERIOD_MASTER a
where
isnull(a.DATA_PRODUCTION, 0) &gt; 0
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LEVEL_AGEN">
      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandText>SELECT DISTINCT(SUBCD),ISNULL(SUBCD_DESCR,'') AS DESCR FROM V_M_AGENTS ORDER BY 2</CommandText>
      </Query>
      <Fields>
        <Field Name="SUBCD">
          <DataField>SUBCD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
