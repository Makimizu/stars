      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>EXEC RPT_COMMISSION_BONUS_PROMOTION
@AGENT_CODE,
@START_DATE,
@END_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@AGENT_CODE">
            <Value>=Parameters!AGENT_CODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@START_DATE">
