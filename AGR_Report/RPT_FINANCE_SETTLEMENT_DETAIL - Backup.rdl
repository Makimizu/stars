      <Query>
        <DataSourceName>AGR</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_FINANCE_SETTLEMENT_DETAIL
@PAYMENT_TYPE,
@CHANNEL,
@YEAR,
@AGENCY_NAME,
@AGENT_NAME,
@PAID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@PAYMENT_TYPE">
            <Value>=Parameters!PAYMENT_TYPE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CHANNEL">
