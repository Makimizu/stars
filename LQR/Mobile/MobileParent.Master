<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MobileParent.master.cs" Inherits="LQR.Mobile.MobileParent" %>

<!DOCTYPE html>

<html lang="en">

<head id="Head1" runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bottom Navbar Bootstrap</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
</head>

<body>
    <div>
        <nav class="navbar navbar-dark navbar-expand fixed-top" style="background-color: darkgreen;">
            <asp:Image ID="IMG_LOGO" Height="60px" runat="server" />
        </nav>
    </div>

    <div class="container mt-4">
        <br />
        <br />
        <br />
        <%--<div class="card">--%>
            <%--<div class="card-body">--%>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            <%--</div>--%>
        <%--</div>--%>
    </div>
    <!-- Bottom Navbar -->
