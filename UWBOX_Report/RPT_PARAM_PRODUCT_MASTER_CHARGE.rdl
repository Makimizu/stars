          </QueryParameter>
          <QueryParameter Name="@TC_ID">
            <Value>=Parameters!TC_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_PARAM_PRODUCT_MASTER_CHARGE
@PRODUCT_CODE,
@TC_ID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
