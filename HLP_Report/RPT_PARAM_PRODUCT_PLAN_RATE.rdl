          <QueryParameter Name="@PLAN_VALUE">
            <Value>=Parameters!PLAN_VALUE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_PARAM_PRODUCT_PLAN_RATE 
@PRODUCT_CODE,
@BENEFIT_ID,
@PLAN_VALUE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
