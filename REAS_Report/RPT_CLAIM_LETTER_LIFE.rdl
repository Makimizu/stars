    <DataSet Name="DEFAULTS">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>select 
REAS = '127',
YEARNUM = YEAR(GETDATE()),
MONTHNUM = MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="REAS">
          <DataField>REAS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="YEARNUM">
