    <DataSet Name="RPT_CLAIM_LETTER_LIFE">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@COMPANY_CODE">
            <Value>=Parameters!COMPANY_CODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_CLAIM_LETTER_LIFE
@COMPANY_CODE,
@START_DATE,
@END_DATE</CommandText>
      </Query>
