    <DataSet Name="MONTH">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>select CODE = 1, DESCR = 'Jan' union all
select CODE = 2, DESCR = 'Feb' union all
select CODE = 3, DESCR = 'Mar' union all
select CODE = 4, DESCR = 'Apr' union all
select CODE = 5, DESCR = 'May' union all
select CODE = 6, DESCR = 'Jun' union all
select CODE = 7, DESCR = 'Jul' union all
select CODE = 8, DESCR = 'Aug' union all
select CODE = 9, DESCR = 'Sep' union all
select CODE = 10, DESCR = 'Oct' union all
select CODE = 11, DESCR = 'Nov' union all
select CODE = 12, DESCR = 'Dec' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YEAR">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>select CODE = convert(int,YEAR(GETDATE())), DESCR = convert(varchar(4),YEAR(GETDATE())) union all
select CODE = convert(int,YEAR(GETDATE())) - 1, DESCR = convert(varchar(4),YEAR(GETDATE()) - 1) union all
select CODE = convert(int,YEAR(GETDATE())) - 2, DESCR = convert(varchar(4),YEAR(GETDATE()) - 2) </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="WEEK">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>
select CODE = 1,DESCR = '1' union all
select CODE = 2,DESCR = '2' union all
select CODE = 3,DESCR = '3' union all
select CODE = 4,DESCR = '4' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DATE">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>select 
START_DATE	= convert(date,DATEADD(dd, -( DAY( GETDATE() ) -1 ), GETDATE())),
END_DATE	= EOMONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
