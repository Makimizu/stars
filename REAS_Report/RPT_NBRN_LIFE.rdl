    <DataSet Name="CURRENT_PERIOD">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>select
YEAR		= YEAR(GETDATE()),
MONTH		= MONTH(GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="YEAR">
          <DataField>YEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MONTH">
          <DataField>MONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MONTHS">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <CommandText>select 
SEQ,
DESCR		= dateName(month,DateAdd(month , SEQ, 0 ) - 1)
from		LIFE.dbo.SC_SEQ 
where 
SEQ			&lt;= 12
order by
SEQ</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
