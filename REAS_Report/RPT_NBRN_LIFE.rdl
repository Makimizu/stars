  <DataSets>
    <DataSet Name="RPT_NBRN_LIFE">
      <Query>
        <DataSourceName>REAS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@YEAR">
            <Value>=Parameters!YEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MONTH">
            <Value>=Parameters!MONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec REINSURANCE.dbo.RPT_NBRN_LIFE
@YEAR,
@MONTH</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
