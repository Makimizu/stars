    <DataSet Name="EFF_DATE">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <CommandText>select 
convert(varchar(20), EFF_DATE, 106) EFF_DATE
from MEMBER_RESERVE_GL a
group by a.EFF_DATE
order by a.EFF_DATE desc</CommandText>
      </Query>
      <Fields>
        <Field Name="EFF_DATE">
          <DataField>EFF_DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
