        <CommandText>exec RPT_MEMBER_PRODUCTION_GL_MONTHLY_DETAIL_ACTUARY 
@THEYEAR,
@THEMONTH</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <QueryParameters>
          <QueryParameter Name="@THEYEAR">
            <Value>=Parameters!THEYEAR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@THEMONTH">
            <Value>=Parameters!THEMONTH.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>0</Timeout>
      </Query>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="THEYEAR">
      <DataType>String</DataType>
      <Prompt>THEYEAR</Prompt>
    </ReportParameter>
    <ReportParameter Name="THEMONTH">
      <DataType>String</DataType>
      <Prompt>THEMONTH</Prompt>
    </ReportParameter>
  </ReportParameters>
</Report>