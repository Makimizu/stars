    <DataSet Name="THEYEAR">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <CommandText>select distinct
THEYEAR	= YEAR(convert(date, PERIOD_CODE + '01')) 
from MEMBER_PRODUCTION_HEALTH_SPLIT
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="THEMONTH">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@THEYEAR">
            <Value>=Parameters!THEYEAR.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct
THEMONTH =MONTH(convert(date, PERIOD_CODE + '01'))
from MEMBER_PRODUCTION_HEALTH_SPLIT
where
YEAR(convert(date, PERIOD_CODE + '01')) = @THEYEAR
order by 1 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEMONTH">
          <DataField>THEMONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PERIOD_DATE">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@THEMONTH">
            <Value>=Parameters!THEMONTH.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@THEYEAR">
            <Value>=Parameters!THEYEAR.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
START_DATE	= convert(date, convert(varchar(2), @THEMONTH) + '/1/' + convert(varchar(4), @THEYEAR)),
END_DATE	= EOMONTH(convert(date, convert(varchar(2), @THEMONTH) + '/1/' + convert(varchar(4), @THEYEAR)))</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE">
          <DataField>END_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
