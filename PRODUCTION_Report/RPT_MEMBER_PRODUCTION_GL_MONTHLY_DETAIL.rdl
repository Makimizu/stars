    <DataSet Name="THEYEAR">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <CommandText>
          select distinct
          THEYEAR	= YEAR(STAT_DATE)
          from MEMBER_PRODUCTION_GL
          order by 1 desc
        </CommandText>
      </Query>
      <Fields>
        <Field Name="THEYEAR">
          <DataField>THEYEAR</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="THEMONTH">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PRODUCTION_YEAR">
            <Value>=Parameters!PRODUCTION_YEAR.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct
THEMONTH	= MONTH(STAT_DATE),
DESCR		= convert(varchar(2), MONTH(STAT_DATE))
from		MEMBER_PRODUCTION_GL
where
YEAR(STAT_DATE) = @PRODUCTION_YEAR

order by 2 desc</CommandText>
      </Query>
      <Fields>
        <Field Name="THEMONTH">
          <DataField>THEMONTH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LO001">
      <Query>
        <DataSourceName>PRODUCTION</DataSourceName>
        <CommandText>select DESCR from GLIFE.dbo.PR_LOADING where CODE = '001'</CommandText>
      </Query>
      <Fields>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
