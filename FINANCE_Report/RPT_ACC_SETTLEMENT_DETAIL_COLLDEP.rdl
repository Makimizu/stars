  <DataSets>
    <DataSet Name="RPT_ACC_SETTLEMENT_DETAIL_COLLDEP">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DESCR">
            <Value>=Parameters!DESCR.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TIPE_SETTLEMENT">
            <Value>=Parameters!TIPE_SETTLEMENT.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@APV_DATE_START">
            <Value>=Parameters!APV_DATE_START.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@APV_DATE_END">
            <Value>=Parameters!APV_DATE_END.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_ACC_SETTLEMENT_DETAIL_COLLDEP
@APP_ID,
@DESCR,
@TIPE_SETTLEMENT,
@APV_DATE_START,
@APV_DATE_END</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TIPE_SETTLEMENT_DESCR">
          <DataField>TIPE_SETTLEMENT_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
