          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RK_TRXID">
          <DataField>RK_TRXID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RESERVED_PARAM1">
          <DataField>RESERVED_PARAM1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="USERDATE">
          <DataField>USERDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select distinct
a.APP_ID, b.APP_NAME
from PARAM_INVOICE_TYPE a
inner join V_LINK_SC_M_APPS b on a.APP_ID=b.CODE
order by 2</CommandText>
      </Query>
      <Fields>
        <Field Name="APP_ID">
          <DataField>APP_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="APP_NAME">
          <DataField>APP_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select 
DAY1 = convert(date,convert(varchar(4),year(GETDATE())) + RIGHT('0'+convert(varchar(2),month(GETDATE())),2) + '01'),
TODAY = convert(date,GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="DAY1">
          <DataField>DAY1</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_TIPE_SETTLEMENT">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
CODE = null,
DESCR = ''
union all
select CODE,DESCR from PARAM_TIPE_SETTLEMENT where APP_ID=@APP_ID order by DESCR</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
