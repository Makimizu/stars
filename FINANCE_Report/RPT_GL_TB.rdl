    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select distinct
b.CODE,
b.START_DATE_DD,
b.END_DATE_DD
from GL_DATA_MASTER a
inner join V_GL_PERIOD b on a.PERIOD=b.CODE
order by
b.START_DATE_DD desc</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="START_DATE_DD">
          <DataField>START_DATE_DD</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="END_DATE_DD">
          <DataField>END_DATE_DD</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PERIOD">
            <Value>=Parameters!PERIOD.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
DEBET = SUM(DEBET),
CREDIT = SUM(CREDIT)
from V_GL_TB 
where 
PERIOD = @PERIOD</CommandText>
      </Query>
      <Fields>
        <Field Name="DEBET">
          <DataField>DEBET</DataField>
