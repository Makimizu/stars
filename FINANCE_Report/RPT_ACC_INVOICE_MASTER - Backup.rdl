      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>exec RPT_ACC_INVOICE_MASTER
@APPID,
@CUSTOMER_CODE,
@CUSTOMER_NAME,
@MEMBER_NAME,
@AR_DATE_START,
@AR_DATE_END</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
