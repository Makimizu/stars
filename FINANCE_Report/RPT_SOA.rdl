    <DataSet Name="BRANCH_NAME">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CUSTOMER_CODE">
            <Value>=Parameters!CUSTOMER_CODE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT A.BRANCH_CODE, A.NAMA_CABANG NAMA_CABANG FROM 
V_LINK_CB_BRANCH A 
INNER JOIN GLIFE.dbo.POLICY B ON A.COMPANY_CODE = B.COMPANY_CODE
WHERE B.POLICY_NO = @CUSTOMER_CODE
ORDER BY A.NAMA_CABANG</CommandText>
      </Query>
      <Fields>
        <Field Name="BRANCH_CODE">
          <DataField>BRANCH_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAMA_CABANG">
          <DataField>NAMA_CABANG</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
