      </DefaultValue>
      <Prompt>A/R DATE START</Prompt>
    </ReportParameter>
    <ReportParameter Name="AR_DATE_END">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>A/R DATE END</Prompt>
