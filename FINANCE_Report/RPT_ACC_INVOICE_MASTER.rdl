        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="AR_DATE_START">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSet3</DataSetName>
          <ValueField>DAY1</ValueField>
