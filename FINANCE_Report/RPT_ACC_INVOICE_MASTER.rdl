  <DataSources>
    <DataSource Name="FINANCE">
      <DataSourceReference>FINANCE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>358740ff-ae6f-400a-80ee-c008b9b89abf</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RPT_ACC_INVOICE_MASTER">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CUSTOMER_CODE">
            <Value>=Parameters!CUSTOMER_CODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CUSTOMER_NAME">
            <Value>=Parameters!CUSTOMER_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@INVOICE_TYPE">
            <Value>=Parameters!INVOICE_TYPE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AR_DATE_START">
            <Value>=Parameters!AR_DATE_START.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AR_DATE_END">
            <Value>=Parameters!AR_DATE_END.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_ACC_INVOICE_MASTER
@APP_ID,
@CUSTOMER_CODE,
@CUSTOMER_NAME,
@INVOICE_TYPE,
@AR_DATE_START,
@AR_DATE_END</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="INVOICENO">
          <DataField>INVOICENO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AR_DATE">
          <DataField>AR_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DISCOUNT">
          <DataField>DISCOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FEEBASE">
          <DataField>FEEBASE</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CUSTOMER_CODE">
          <DataField>CUSTOMER_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUSTOMER_NAME">
          <DataField>CUSTOMER_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INVOICE_TYPE_DESCR">
          <DataField>INVOICE_TYPE_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select distinct
a.APP_ID, b.APP_NAME
from PARAM_INVOICE_TYPE a
inner join V_LINK_SC_M_APPS b on a.APP_ID=b.CODE
order by 2</CommandText>
      </Query>
      <Fields>
        <Field Name="APP_ID">
          <DataField>APP_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="APP_NAME">
          <DataField>APP_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select DAY1 = convert(date,convert(varchar(4),year(GETDATE())) + RIGHT('0'+convert(varchar(2),month(GETDATE())),2) + '01')</CommandText>
      </Query>
      <Fields>
        <Field Name="DAY1">
          <DataField>DAY1</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_INVOICE_TYPE">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select INVOICE_TYPE,DESCR from PARAM_INVOICE_TYPE where APP_ID=@APP_ID order by INVOICE_TYPE</CommandText>
      </Query>
      <Fields>
        <Field Name="INVOICE_TYPE">
          <DataField>INVOICE_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="APP_ID">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSet2</DataSetName>
          <ValueField>APP_ID</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>APP</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>DataSet2</DataSetName>
          <ValueField>APP_ID</ValueField>
          <LabelField>APP_NAME</LabelField>
        </DataSetReference>
      </ValidValues>
