    <DataSet Name="APP_ID">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select distinct 
APP_ID ,
APP_NAME
from V_INVOICE_MASTER a
inner join V_LINK_SC_M_APPS b on a.APP_ID = b.CODE collate database_default
where OUTSTANDING &gt; 0
order by 2</CommandText>
      </Query>
      <Fields>
        <Field Name="APP_ID">
          <DataField>APP_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="APP_NAME">
          <DataField>APP_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="INVOICE_TYPE">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 
INVOICE_TYPE = '',
DESCR = ''

union all

select 
INVOICE_TYPE,
DESCR
from PARAM_INVOICE_TYPE a
where
a.APP_ID = @APP_ID</CommandText>
      </Query>
      <Fields>
        <Field Name="INVOICE_TYPE">
          <DataField>INVOICE_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
