        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PERIOD">
            <Value>=Parameters!PERIOD.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select START_DATE, END_DATE from GL_PERIOD where CODE = @PERIOD</CommandText>
      </Query>
      <Fields>
        <Field Name="START_DATE">
          <DataField>START_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
