            <Value>=Parameters!APPID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select INVOICE_TYPE,DESCR from PARAM_INVOICE_TYPE where APP_ID=@APPID order by INVOICE_TYPE</CommandText>
      </Query>
