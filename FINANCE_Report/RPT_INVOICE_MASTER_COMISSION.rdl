    <DataSet Name="DAY1">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select 
DAY1 = dbo.UFN_GET_FIRSTLAST_DOM(0),
TODAY = convert(date,GETDATE()),
LASTDAY = dbo.UFN_GET_FIRSTLAST_DOM(1)</CommandText>
      </Query>
      <Fields>
