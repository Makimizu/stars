    <DataSet Name="DAY1">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select 
DAY1 = convert(date,convert(varchar(4),year(GETDATE())) + RIGHT('0'+convert(varchar(2),month(GETDATE())),2) + '01'),
TODAY = convert(date,GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="DAY1">
          <DataField>DAY1</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
