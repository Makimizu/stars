        </Field>
        <Field Name="LOADING_CODE">
          <DataField>LOADING_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOADING_DESCR">
          <DataField>LOADING_DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOADING_VAL">
          <DataField>LOADING_VAL</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="APP">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select
CODE, APP_NAME
from V_LINK_SC_M_APPS
where
CODE in ('HO','GL')</CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="APP_NAME">
          <DataField>APP_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
