        <CommandText>select MODE='', DESCR='' union all
select MODE='INV', DESCR='INVOICE' union all
select MODE='PAY', DESCR='PAYMENT' union all
select MODE='CN', DESCR='CREDIT NOTE' union all
select MODE='DN', DESCR='DEBET NOTE' union all
select MODE='WO', DESCR='WRITE OFF'</CommandText>
