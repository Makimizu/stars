    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select
FIRST_DATE = convert(date, '1 jan ' + convert(varchar(10),YEAR(GETDATE()))),
FIRST_DATE_TEXT = '1 jan ' + convert(varchar(10),YEAR(GETDATE())),
TODAY = convert(date, GETDATE()),
TODAY_TEXT = convert(varchar(20), GETDATE(), 106)</CommandText>
      </Query>
