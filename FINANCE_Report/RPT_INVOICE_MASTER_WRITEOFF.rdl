    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select distinct
a.APP_ID,
b.APP_NAME
from INVOICE_NOTA a
inner join V_LINK_SC_M_APPS b on a.APP_ID = b.CODE</CommandText>
      </Query>
      <Fields>
        <Field Name="APP_ID">
          <DataField>APP_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
