                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Apabila sampai dengan tanggal jatuh tempo tersebut belum dibayarkan, maka pelayanan provider dan klaim kesehatan akan dilakukan dengan </Value>
                              <Style>
                                <FontFamily>tahoma</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>Normal</FontWeight>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>Sistem Reimbursement.</Value>
                              <Style>
