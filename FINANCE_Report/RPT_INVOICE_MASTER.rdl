                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Apabila sampai jatuh tempo tersebut belum dibayarkan, maka pelayanan provider dan klaim kesehatan akan di lakukan dengan system </Value>
                              <Style />
                            </TextRun>
                            <TextRun>
                              <Value>Reimbursement</Value>
                              <Style>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>.</Value>
                              <Style />
                            </TextRun>
                          </TextRuns>
                          <Style />
