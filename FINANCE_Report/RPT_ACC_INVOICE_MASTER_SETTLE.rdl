  <DataSets>
    <DataSet Name="RPT_ACC_INVOICE_MASTER">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CUSTOMER_CODE">
            <Value>=Parameters!CUSTOMER_CODE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CUSTOMER_NAME">
            <Value>=Parameters!CUSTOMER_NAME.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@INVOICE_TYPE">
            <Value>=Parameters!INVOICE_TYPE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STL_DATE_START">
            <Value>=Parameters!STL_DATE_START.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@STL_DATE_END">
            <Value>=Parameters!STL_DATE_END.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@NOREK">
            <Value>=Parameters!NOREK.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_ACC_INVOICE_MASTER_SETTLE
@APP_ID,
@CUSTOMER_CODE,
@CUSTOMER_NAME,
@INVOICE_TYPE,
@STL_DATE_START,
@STL_DATE_END,
@NOREK</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="INVOICENO">
          <DataField>INVOICENO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INVOICE_DATE">
          <DataField>INVOICE_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="STL_DATE">
          <DataField>STL_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
