          <DataField>POST_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PAYMENT_AMOUNT">
          <DataField>PAYMENT_AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OUTSTANDING">
          <DataField>OUTSTANDING</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="REGNO">
          <DataField>REGNO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select		APP_ID = a.CODE,APP_NAME = a.APP_NAME
from		SECURITY.dbo.M_APPS a 
where
a.CODE in	('LF','GL','HO')</CommandText>
      </Query>
      <Fields>
        <Field Name="APP_ID">
          <DataField>APP_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="APP_NAME">
          <DataField>APP_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select DAY1 = convert(date,convert(varchar(4),year(GETDATE())) + RIGHT('0'+convert(varchar(2),month(GETDATE())),2) + '01')</CommandText>
      </Query>
      <Fields>
        <Field Name="DAY1">
          <DataField>DAY1</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PARAM_INVOICE_TYPE">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@APP_ID">
            <Value>=Parameters!APP_ID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select INVOICE_TYPE = '', DESCR = ''
union all
select INVOICE_TYPE,DESCR from PARAM_INVOICE_TYPE where APP_ID=@APP_ID order by INVOICE_TYPE</CommandText>
      </Query>
      <Fields>
        <Field Name="INVOICE_TYPE">
          <DataField>INVOICE_TYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="REKENING_MASTER">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select NOREK='', BANK='' union all 
select NOREK, BANK from REKENING_MASTER order by 2</CommandText>
      </Query>
      <Fields>
        <Field Name="NOREK">
          <DataField>NOREK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BANK">
          <DataField>BANK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
