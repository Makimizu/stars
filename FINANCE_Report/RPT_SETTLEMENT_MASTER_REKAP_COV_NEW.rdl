  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@START_DATE">
            <Value>=Parameters!START_DATE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@END_DATE">
            <Value>=Parameters!END_DATE.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>exec RPT_SETTLEMENT_MASTER_REKAP_COV_NEW
@START_DATE,
@END_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ACC_SOURCE">
          <DataField>ACC_SOURCE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ACC_SOURCE_BANK">
          <DataField>ACC_SOURCE_BANK</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INHOUSE">
          <DataField>INHOUSE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
