          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="WORDS">
          <DataField>WORDS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select 
FIRSTDATE = convert(date,dateadd(day, -(DAY(GETDATE()))+1, GETDATE())),
TODAY = convert(date,GETDATE())</CommandText>
      </Query>
      <Fields>
        <Field Name="FIRSTDATE">
          <DataField>FIRSTDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TODAY">
          <DataField>TODAY</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="START_DATE">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSet2</DataSetName>
          <ValueField>FIRSTDATE</ValueField>
        </DataSetReference>
      </DefaultValue>
