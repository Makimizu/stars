                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Assalamualaikum wr.wb.</Value>
                                  <Style>
                                    <FontStyle>Italic</FontStyle>
                                    <FontFamily>arial</FontFamily>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>
Penghargaan dan terima kasih kami sampaikan atas kepercayaan yang telah diberikan kepada PT Asuransi Takaful Keluarga.</Value>
                                  <Style>
                                    <FontFamily>arial</FontFamily>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
