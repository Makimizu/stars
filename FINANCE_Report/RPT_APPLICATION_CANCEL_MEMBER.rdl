                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Sehubungan dengan </Value>
                                  <Style>
                                    <FontFamily>arial</FontFamily>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>Invoice / Cover Note</Value>
                                  <Style>
                                    <FontFamily>arial</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>  yang telah kami kirimkan sebelumnya, bersama ini kami sampaikan kembali data peserta Asuransi Takaful Pembiayaan dari  </Value>
                                  <Style>
                                    <FontFamily>arial</FontFamily>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value>=Fields!PolicyHolder.Value</Value>
