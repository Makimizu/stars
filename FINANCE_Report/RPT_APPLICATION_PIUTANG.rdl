    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <CommandText>select 
INVOICE_TYPE = '', 
DESCR = ''
union all
select INVOICE_TYPE,DESCR from PARAM_INVOICE_TYPE where APP_ID = 'HO' order by 1</CommandText>
      </Query>
