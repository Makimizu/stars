        <CommandType>Text</CommandType>
        <CommandText>exec RPT_INVOICE_MASTER_NOTA
@NOTA_DATE_FROM,
@NOTA_DATE_TO,
@APP_ID,
@NOTA_TYPE,
@DC,
@INVOICE_TYPE</CommandText>
