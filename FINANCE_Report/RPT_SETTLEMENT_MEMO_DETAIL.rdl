    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>FINANCE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@REKAPID">
            <Value>=Parameters!REKAPID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
a.AMOUNT,
a.WORDS,
PERSON	= LTRIM(RTRIM(isnull(c.FRONT_NAME,'') + ' ' + isnull(c.LAST_NAME,''))),
c.SIGNATURE,
THEDATE = b.APPROVALDATE
from
(
select 
AMOUNT = SUM(AMOUNT),
WORDS = [dbo].[UFN_TERBILANG](SUM(AMOUNT))
from SETTLEMENT_DETAIL 
where 
REKAPID = @REKAPID
) a
inner join SETTLEMENT_MASTER b on b.REKAPID = @REKAPID
left join V_LINK_SC_M_USERS c on b.APPROVALBY = c.CODE collate database_default</CommandText>
      </Query>
      <Fields>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="WORDS">
          <DataField>WORDS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PERSON">
          <DataField>PERSON</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SIGNATURE">
          <DataField>SIGNATURE</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
        <Field Name="THEDATE">
          <DataField>THEDATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
