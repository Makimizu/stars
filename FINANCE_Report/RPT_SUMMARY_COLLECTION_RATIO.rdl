              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="DESCR">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!DESCR.Value</Value>
                              <Style>
                                <FontFamily>Tahoma</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>=Iif(Fields!DESCR.Value = "Tertagih","#2f75b5",Iif(Fields!DESCR.Value = "Tertagih bulan sebelumnya","Red", Iif(Fields!DESCR.Value = "Total Piutang Tertagih","#375623", "Black")))</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Left</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
