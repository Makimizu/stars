    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select SEQ=null, DESCR='-- ALL --' union all
select SEQ, DESCR from PARAM_TRACK where TIPE_CODE='CLMMASTER' order by SEQ desc</CommandText>
      </Query>
      <Fields>
        <Field Name="SEQ">
          <DataField>SEQ</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>ASKES</DataSourceName>
        <CommandText>select CODE = '', DESCR = '-- ALL --' union all
select CODE = 'P', DESCR = 'PROVIDER' union all
select CODE = 'R', DESCR = 'REIMBURSEMENT' </CommandText>
      </Query>
      <Fields>
        <Field Name="CODE">
          <DataField>CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCR">
          <DataField>DESCR</DataField>
